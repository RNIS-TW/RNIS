---
import '../styles/font/font.css';
import '../styles/font/genyo-gothic.css';
import '../styles/global.css';
import 'lenis/dist/lenis.css';
import { ClientRouter } from 'astro:transitions';
import satoshiUrl from '../assets/font/Satoshi_Complete/Satoshi_Complete/Fonts/WEB/fonts/Satoshi-Variable.woff2?url';
import archivoBlackUrl from '../assets/font/ArchivoBlack/ArchivoBlack-Regular.woff2?url';
import Background from "@utils/Background.astro";
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import SmoothScroll from "@utils/SmoothScroll.astro";
import footer from '../content/footer.json';

import logoUrl from '../assets/logo.svg?url';

const { left: mainName } = footer;
---

<!doctype html>
<html lang="zh-Hant" data-theme="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link
		    rel="preload"
		    href={satoshiUrl}
		    as="font"
		    type="font/woff2"
		    crossorigin
		/>
		<link
		    rel="preload"
		    href={archivoBlackUrl}
		    as="font"
		    type="font/woff2"
		    crossorigin
		/>
		<link rel="icon" type="image/svg+xml" href={logoUrl} />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#151c2a" />
		<ClientRouter />
		<script is:inline>
			(() => {
				const storageKey = 'rnis-theme';
				let savedTheme = null;

				try {
					savedTheme = localStorage.getItem(storageKey);
				} catch {}

				const theme = savedTheme === 'light' || savedTheme === 'dark'
					? savedTheme
					: matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';

				document.documentElement.dataset.theme = theme;
				document.documentElement.style.colorScheme = theme;
			})();
		</script>
		<title>{mainName}</title>
	</head>
	<body>
		<SmoothScroll transition:persist />
		<Background transition:persist />
		<Header transition:persist />
		<main class="site-content" transition:animate="fade">
			<slot />
		</main>
		<Footer transition:persist />
	</body>
</html>

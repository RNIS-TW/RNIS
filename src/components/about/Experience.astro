---
import config from "@content/about.json";
import { ChevronLeft, ChevronRight } from "@lucide/astro/icons";

const { experience } = config;
---

<section id="experience" class="w-full h-fit bg-surface-base py-16 lg:py-24">
    <div class="container mx-auto px-6 sm:px-10 lg:px-16">
        <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-6 mb-8 lg:mb-12">
            <div class="flex flex-col gap-4 max-w-2xl">
                <h2 class="text-3xl sm:text-4xl lg:text-5xl text-amber-100 font-line-seed">{experience.title}</h2>
                <p class="text-base sm:text-lg text-secondary">{experience.description}</p>
            </div>

            <div class="hidden sm:flex gap-3 shrink-0">
                <button
                    type="button"
                    class="experience-arrow"
                    data-experience-prev
                    aria-label="上一項"
                >
                    <ChevronLeft class="w-5 h-5" />
                </button>
                <button
                    type="button"
                    class="experience-arrow"
                    data-experience-next
                    aria-label="下一項"
                >
                    <ChevronRight class="w-5 h-5" />
                </button>
            </div>
        </div>

        <div class="experience-track flex gap-6 overflow-x-auto" data-experience-track>
            {
                experience.items.map((item) => (
                    <div class="experience-card shrink-0 w-[260px] sm:w-[320px] flex flex-col bg-surface-raised border border-amber-100/20">
                        <div class="w-full h-36 sm:h-44 overflow-hidden">
                            <img
                                src={item.image}
                                alt={item.title}
                                class="w-full h-full object-cover"
                                loading="lazy"
                                decoding="async"
                            />
                        </div>
                        <div class="p-5 flex flex-col gap-2">
                            <span class="text-xs tracking-wide text-amber-300">{item.year}</span>
                            <h3 class="text-lg text-amber-100 font-medium">{item.title}</h3>
                            <p class="text-sm text-secondary leading-relaxed">{item.description}</p>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<style>
    .experience-track {
        scroll-snap-type: x mandatory;
        scrollbar-width: none;
    }

    .experience-track::-webkit-scrollbar {
        display: none;
    }

    .experience-card {
        scroll-snap-align: start;
        transition:
            transform 250ms cubic-bezier(0.4, 0, 0.2, 1),
            border-color 250ms ease;
    }

    .experience-card:hover {
        transform: translateY(-4px);
        border-color: var(--color-amber-100);
    }

    .experience-arrow {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 2.5rem;
        height: 2.5rem;
        color: var(--text-primary);
        border: 1px solid var(--color-amber-100);
        cursor: pointer;
        transition:
            background-color 200ms ease,
            color 200ms ease;
    }

    .experience-arrow:hover {
        background: var(--color-amber-100);
        color: var(--color-surface-base);
    }
</style>

<script>
    const init = () => {
        const track = document.querySelector<HTMLElement>("[data-experience-track]");
        if (!track) return;

        const prevButton = document.querySelector<HTMLButtonElement>("[data-experience-prev]");
        const nextButton = document.querySelector<HTMLButtonElement>("[data-experience-next]");

        const controller = new AbortController();
        const { signal } = controller;

        const scrollByCard = (direction: 1 | -1) => {
            const card = track.querySelector<HTMLElement>(".experience-card");
            const amount = (card?.getBoundingClientRect().width ?? 300) + 24;
            track.scrollBy({ left: direction * amount, behavior: "smooth" });
        };

        prevButton?.addEventListener("click", () => scrollByCard(-1), { signal });
        nextButton?.addEventListener("click", () => scrollByCard(1), { signal });

        document.addEventListener(
            "astro:before-swap",
            () => controller.abort(),
            { once: true },
        );
    };

    // This script is a processed module, and browsers only ever evaluate a
    // given module URL once — re-inserting it on later navigations is a
    // no-op. astro:page-load fires once for the initial load and again
    // after every subsequent navigation, so binding init() to it (and only
    // it) re-queries the track/buttons against the fresh DOM every time.
    document.addEventListener("astro:page-load", init);
</script>

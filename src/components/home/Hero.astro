---
import HeroCut from "@svg/heroCut.astro";
import config from "@content/home.json"

---

<!--
    The 128vh track holds the 94vh hero for 34vh. Its negative bottom margin
    keeps Services at its original position, releasing the hero at top: 60vh.
-->
<section class="relative h-[112vh] mb-[-18vh]">
    <div class="sticky top-0 w-full h-[94vh]">
        <div class="container mx-auto px-16 flex flex-col items-center justify-start w-full h-full">
            <div class="h-24"></div>
            <div class="flex-1 flex flex-col gap-8 items-start justify-center w-full">

                <h1 class="text-8xl font-line-seed text-amber-100">{(config.hero.title).split('|')[0]}<br>{(config.hero.title).split('|')[1]}</h1>
                <p class="text-xl font-sans text-primary">{config.hero.description}</p>

            </div>
            <div class="h-40"></div>
        </div>
        <HeroCut class="absolute bottom-0 left-0" />
    </div>
</section>

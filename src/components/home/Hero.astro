---
import HeroCut from "@svg/heroCut.astro";
import config from "@content/home.json"

---

<section class="relative h-[108vh] mb-[-22vh]">
    <div class="sticky top-0 w-full h-[94vh]">
        <div class="container mx-auto px-6 sm:px-10 lg:px-16 flex flex-col items-center justify-start w-full h-full">
            <div class="h-16 sm:h-20 lg:h-24"></div>
            <div class="flex-1 flex flex-col gap-4 sm:gap-6 lg:gap-8 items-start justify-center w-full">

                <h1 class="text-4xl sm:text-6xl md:text-7xl lg:text-8xl font-line-seed text-amber-100">{(config.hero.title).split('|')[0]}<br>{(config.hero.title).split('|')[1]}</h1>
                <p class="text-base sm:text-lg lg:text-xl font-sans text-primary">{config.hero.description}</p>

            </div>
            <div class="h-20 sm:h-28 lg:h-40"></div>
        </div>
        <HeroCut class="absolute bottom-0 left-0 z-20" />
    </div>
</section>

---
import config from "@content/home.json";

const { About } = config;
const titleLines = About.title.split("\n");
const paragraphs = About.description.split("\n\n");
---

<section class="w-full bg-ink-black py-24">
    <div class="container mx-auto px-16 w-full h-full flex items-center justify-between gap-10">
        <div class="h-fit flex flex-col items-start gap-10">
            <div class="w-full h-auto flex flex-col items-start justify-center gap-4">
                <h1 class="text-5xl text-icy-blue font-line-seed leading-tight mb-4">
                    {
                        titleLines.map((line, index) => (
                            <>
                                {index > 0 && <br />}
                                {line}
                            </>
                        ))
                    }
                </h1>
                {
                    paragraphs.map((paragraph) => (
                        <p class="text-lg text-powder-blue leading-relaxed">
                            {paragraph}
                        </p>
                    ))
                }
            </div>

            <ul class="flex flex-col gap-3 text-lg text-powder-blue">
                {
                    About.skills.map((skill) => (
                        <li class="flex gap-3 items-start">
                            <span class="mt-2 w-2 h-2 shrink-0 bg-icy-blue shadow-[2px_2px_0_0_#8A6A2C]" />
                            <span>{skill}</span>
                        </li>
                    ))
                }
            </ul>

            <div class="w-full h-fit flex items-end justify-start gap-2">
                <a
                    href="/about"
                    class="w-fit h-fit px-4 py-2 bg-yale-blue border border-icy-blue button duration-100 relative"
                >
                    <p class="text-sm text-alice-blue">{About.buttons.learnMore}</p>
                </a>
                <a
                    href="#services"
                    class="w-fit h-fit px-4 py-2 bg-yale-blue border border-icy-blue button duration-100 relative"
                >
                    <p class="text-sm text-alice-blue">{About.buttons.services}</p>
                </a>
            </div>
        </div>
        <div class="w-1/3 h-[60vh]">
            <img
                src="https://images.pexels.com/photos/13258030/pexels-photo-13258030.jpeg"
                alt="testing"
                class="w-auto h-full object-cover"
            />
        </div>
    </div>
</section>

<style>
    .button:hover {
        transform: translateY(-2px);
    }
</style>

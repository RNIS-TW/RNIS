<section class="w-full h-[120vh] bg-ink-black">
    <div class="container mx-auto px-32 w-full h-full flex items-center justify-between gap-16">
        <div class="w-1/2 h-[60vh] flex flex-col items-start justify-between">
            <div class="w-full h-auto flex flex-col items-start justify-center">
                <h1 class="text-6xl text-alice-blue mb-4">
                    優質團隊老闆發 MACBOOK
                </h1>
                <p class="text-2xl text-alice-blue underline underline-offset-8 leading-10 decoration-cool-sky pr-8 mb-8">
                    我們相信優質的老闆會發優質的 macbook 提升員工生活品質
                </p>
                <p class="text-lg text-alice-blue">
                    我們相信優質的老闆會發優質的 macbook 提升員工生活品質
                </p>
            </div>

            <div class="w-full h-fit">

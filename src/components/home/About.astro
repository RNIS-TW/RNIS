                            alt="testing"
                            class="aspect-square rounded-2xl object-cover mr-2"
                        />
                        <div class="w-fit h-fit flex flex-col items-start justify-center">
                            <p class="text-xs">founder</p>
                            <p class="text-xl">河馬</p>
                        </div>
                    </div>
                    <div class="w-fit h-16 p-2 border-icy-blue border-b flex">

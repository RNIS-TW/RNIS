---
import config from "@content/home.json";
import { Server, Code, Gamepad2, Users } from "@lucide/astro/icons";
import NotchButton from "@utils/NotchButton.astro";

const { About } = config;
const titleLines = About.title.split("\n");
const paragraphs = About.description.split("\n\n");

const skillIcons = [Server, Code, Gamepad2, Users];
const skills = About.skills.map((skill) => {
    const [title, ...rest] = skill.split("：");
    return { title, description: rest.join("：") };
});
---

<section class="w-full h-[120vh] bg-surface-base py-24">
    <div class="container mx-auto px-16">
        <div class="w-full h-fit mb-16">
            <div class="w-6/10 h-auto flex flex-col items-start justify-center gap-4">
                <h1 class="text-5xl text-amber-100 font-line-seed leading-tight mb-4">
                    {
                        titleLines.map((line, index) => (
                            <>
                                {index > 0 && <br />}
                                {line}
                            </>
                        ))
                    }
                </h1>
                {
                    paragraphs.map((paragraph) => (
                        <p class="text-lg text-secondary leading-relaxed">
                            {paragraph}
                        </p>
                    ))
                }
            </div>
        </div>
        <div class="w-full h-[50vh] flex items-center justify-between gap-10">
            <div class="flex-2 h-full flex flex-col items-center justify-between gap-10">
                <div class="w-full grid grid-cols-2 gap-4">
                    {
                        skills.map((skill, index) => {
                            const Icon = skillIcons[index] ?? Server;
                            return (
                                <div class="flex flex-col gap-3 p-4 bg-surface-raised border border-amber-100/20 duration-300 hover:-translate-y-1 hover:border-amber-100">
                                    <div class="w-10 h-10 shrink-0 shadow-[4px_4px_0_0_var(--color-amber-300)] bg-amber-100 flex items-center justify-center text-surface-base">
                                        <Icon class="w-5 h-5" />
                                    </div>
                                    <p class="text-base text-amber-100 font-medium">
                                        {skill.title}
                                    </p>
                                    <p class="text-sm text-secondary leading-relaxed">
                                        {skill.description}
                                    </p>
                                </div>
                            );
                        })
                    }
                </div>

                <div class="w-full h-fit flex items-end justify-start gap-4">
                    <NotchButton
                        as="a"
                        href="/about"
                        color="var(--color-amber-100)"
                        class="w-fit text-amber-100 font-medium"
                    >
                        {About.buttons.learnMore}
                    </NotchButton>
                    <NotchButton
                        as="a"
                        href="#services"
                        color="var(--color-amber-100)"
                        class="w-fit text-amber-100 font-medium"
                    >
                        {About.buttons.services}
                    </NotchButton>
                </div>
            </div>
            <div class="flex-1 h-full">
                <img
                    src={About.image.src}
                    alt={About.image.alt}
                    class="w-auto h-full object-cover notch-border"
                />
            </div>
        </div>
    </div>
</section>

<style>

    .notch-border {
        border: 2px solid var(--color-amber-200);
        border-radius: 24px;
        box-shadow: 6px 6px 0 0 var(--color-amber-400);
        corner-top-left-shape: notch;
        corner-top-right-shape: square;
        corner-bottom-left-shape: square;
        corner-bottom-right-shape: notch;
    }

</style>
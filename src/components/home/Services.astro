---
import config from "@content/home.json";
import NotchButton from "@components/common/NotchButton.astro";

import { MessageSquare } from "@lucide/astro/icons";

const { Services } = config;
const { items, whyUs } = Services;
const defaultIndex = 0;
const active = items[defaultIndex];
---

<script>
    const services = document.getElementById("services-panel");

    if (services) {
        const servicesHeight = services.offsetHeight;
        const viewHeight = window.innerHeight;

        const sitckyTopOffset = (viewHeight - servicesHeight) / 2;

        services.style.top = `${sitckyTopOffset}px`;
    }
</script>

<section
    id="services"
    class="w-full h-fit bg-ink-black relative trans-hero"
>
    <div class="container px-16 mx-auto p-16 h-fit flex gap-8 items-start">
        <div
            class="w-1/2 py-8 mt-8 sticky self-start"
            id="services-panel"
        >
            <div class="w-fit h-fit mb-12">
                <h1 class="text-5xl text-icy-blue font-line-seed">{Services.servicesTitle}</h1>
                <p class="text-lg mt-4 text-powder-blue">{Services.servicesContent}</p>
            </div>

            <div
                class="w-full h-fit mt-8 py-4 flex flex-col gap-4"
                id="services-list"
            >
                {
                    items.map((item, index) => (
                        <>
                            <div class="w-7/8 h-0.5 bg-icy-blue/20" />
                            <button
                                type="button"
                                data-service-item
                                data-index={index}
                                aria-pressed={index === defaultIndex ? "true" : "false"}
                                class:list={[
                                    "service-item w-full h-fit py-4 px-2 flex gap-8 items-center text-left cursor-pointer transition-colors",
                                    index === defaultIndex && "is-active",
                                ]}
                            >
                                <div
                                    data-service-icon
                                    class:list={[
                                        "w-14 h-14 shrink-0 shadow-[6px_6px_0_0_#8A6A2C] flex items-center justify-center text-2xl text-ink-black font-line-seed transition-colors",
                                        index === defaultIndex ? "bg-cool-sky" : "bg-icy-blue",
                                    ]}
                                >
                                    {index + 1}
                                </div>
                                <div class="w-fit h-fit flex flex-col gap-2">
                                    <div class="flex items-center gap-2">
                                        <h2 class="text-3xl text-icy-blue">{item.title}</h2>
                                        <span
                                            data-service-badge
                                            class:list={[
                                                "px-2 py-0.5 text-xs font-medium tracking-wide bg-cool-sky text-ink-black transition-opacity",
                                                index === defaultIndex ? "opacity-100" : "opacity-0",
                                            ]}
                                        >
                                            詳細介紹 →
                                        </span>
                                    </div>
                                    <p class="text-sm text-powder-blue">{item.description}</p>
                                </div>
                            </button>
                        </>
                    ))
                }
            </div>
        </div>

        <div class="w-1/2 mt-56 p-12 text-alice-blue flex flex-col gap-10">
            <div id="service-detail-panel" class="service-detail-panel flex flex-col gap-10">
                <div class="flex flex-col gap-3">
                    <span
                        id="service-detail-tag"
                        class="w-fit px-3 py-1 text-sm font-medium tracking-wide bg-icy-blue text-ink-black"
                    >
                        {String(defaultIndex + 1).padStart(2, "0")} · {active.tag}
                    </span>
                    <h3
                        id="service-detail-title"
                        class="text-4xl font-display leading-tight text-icy-blue"
                    >
                        {active.title}
                    </h3>
                    <p
                        id="service-detail-description"
                        class="text-base text-powder-blue/90 leading-relaxed"
                    >
                        {active.description}
                    </p>
                </div>

                <div class="w-full h-0.5 bg-icy-blue/30"></div>

                <div class="flex flex-col gap-4">
                    <h4 class="text-xl font-medium text-icy-blue">我們會幫你做什麼</h4>
                    <ul
                        id="service-detail-bullets"
                        class="flex flex-col gap-3 text-sm text-powder-blue"
                    >
                        {
                            active.bullets.map((bullet) => (
                                <li class="flex gap-3 items-start">
                                    <span class="mt-2 w-2 h-2 shrink-0 bg-icy-blue shadow-[2px_2px_0_0_#8A6A2C]" />
                                    <span>{bullet}</span>
                                </li>
                            ))
                        }
                    </ul>
                </div>

                <div class="flex flex-col gap-4">
                    <h4 class="text-xl font-medium text-icy-blue">適用場景</h4>
                    <div
                        id="service-detail-scenarios"
                        class="flex flex-wrap gap-2"
                    >
                        {
                            active.scenarios.map((scenario) => (
                                <span class="px-3 py-1.5 text-sm text-ink-black bg-alice-blue border border-ink-black/20">
                                    {scenario}
                                </span>
                            ))
                        }
                    </div>
                </div>
            </div>

            <div class="mt-auto pt-4 flex flex-col gap-4">
                <div class="p-5 bg-jet-black border border-icy-blue/20 text-alice-blue flex flex-col gap-3">
                    <p class="text-sm text-icy-blue">{whyUs.title}</p>
                    {
                        whyUs.paragraphs.map((paragraph) => (
                            <p class="text-sm text-powder-blue leading-relaxed">
                                {paragraph}
                            </p>
                        ))
                    }
                </div>
                <NotchButton
                    as="a"
                    href="#contact"
                    color="var(--color-icy-blue)"
                    class="w-fit text-icy-blue font-medium"
                    corners={{
                        // topRight: true,
                        // topLeft: false,
                        // bottomRight: false,
                        // bottomLeft: false,
                    }}
                >
                    <MessageSquare class="w-4 h-4" />
                    聊聊你的需求
                </NotchButton>
            </div>
        </div>
    </div>
</section>

<style>
    .trans-hero::after {
        content: "";
        position: absolute;
        top: -4px;
        right: 0;
        height: 4px;
        width: 100%;
        background-color: var(--color-icy-blue);
        z-index: -1;
    }

    .service-item:hover:not(.is-active) {
        background-color: rgba(255, 221, 138, 0.05);
    }

    .service-item.is-active {
        background-color: rgba(255, 221, 138, 0.05);
    }

    .service-detail-panel {
        transition:
            opacity 200ms ease,
            transform 200ms cubic-bezier(0.4, 0, 0.2, 1);
    }

    .service-detail-panel.is-switching {
        opacity: 0;
        transform: translateY(8px);
    }
</style>

<script define:vars={{ items: config.Services.items, defaultIndex }}>
    const list = document.getElementById("services-list");
    const buttons = Array.from(
        document.querySelectorAll("[data-service-item]"),
    );

    const panelEl = document.getElementById("service-detail-panel");
    const tagEl = document.getElementById("service-detail-tag");
    const titleEl = document.getElementById("service-detail-title");
    const descriptionEl = document.getElementById("service-detail-description");
    const bulletsEl = document.getElementById("service-detail-bullets");
    const scenariosEl = document.getElementById("service-detail-scenarios");

    let activeIndex = defaultIndex;
    let isSwitching = false;

    const renderBullets = (bullets) => {
        bulletsEl.innerHTML = "";
        for (const bullet of bullets) {
            const li = document.createElement("li");
            li.className = "flex gap-3 items-start";

            const dot = document.createElement("span");
            dot.className =
                "mt-2 w-2 h-2 shrink-0 bg-icy-blue shadow-[2px_2px_0_0_#8A6A2C]";

            const text = document.createElement("span");
            text.textContent = bullet;

            li.append(dot, text);
            bulletsEl.append(li);
        }
    };

    const renderScenarios = (scenarios) => {
        scenariosEl.innerHTML = "";
        for (const scenario of scenarios) {
            const span = document.createElement("span");
            span.className =
                "px-3 py-1.5 text-sm text-ink-black bg-alice-blue border border-ink-black/20";
            span.textContent = scenario;
            scenariosEl.append(span);
        }
    };

    const applyContent = (index) => {
        const item = items[index];

        tagEl.textContent = `${String(index + 1).padStart(2, "0")} · ${item.tag}`;
        titleEl.textContent = item.title;
        descriptionEl.textContent = item.description;
        renderBullets(item.bullets);
        renderScenarios(item.scenarios);

        for (const button of buttons) {
            const buttonIndex = Number(button.dataset.index);
            const isActive = buttonIndex === index;

            button.classList.toggle("is-active", isActive);
            button.setAttribute("aria-pressed", String(isActive));

            const icon = button.querySelector("[data-service-icon]");
            icon?.classList.toggle("bg-cool-sky", isActive);
            icon?.classList.toggle("bg-icy-blue", !isActive);

            const badge = button.querySelector("[data-service-badge]");
            badge?.classList.toggle("opacity-100", isActive);
            badge?.classList.toggle("opacity-0", !isActive);
        }
    };

    const setActive = (index) => {
        if (index === activeIndex || isSwitching) return;
        activeIndex = index;
        isSwitching = true;

        panelEl.classList.add("is-switching");

        window.setTimeout(() => {
            applyContent(index);
            panelEl.classList.remove("is-switching");
            isSwitching = false;
        }, 200);
    };

    for (const button of buttons) {
        button.addEventListener("click", () => {
            setActive(Number(button.dataset.index));
        });
    }
</script>

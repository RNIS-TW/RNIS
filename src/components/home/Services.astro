---
import config from "@content/home.json";
import NotchButton from "@utils/NotchButton.astro";

import { MessageSquare, Lightbulb, Server, Wrench } from "@lucide/astro/icons";

const { Services } = config;
const { items, whyUs } = Services;
const defaultIndex = 0;

const icons = [Lightbulb, Server, Wrench];
---

<section
    id="services"
    class="w-full h-fit bg-surface-base relative trans-hero"
>
    <div class="container px-16 mx-auto p-16 h-fit flex gap-8 items-start">
        <div
            class="w-1/2 py-8 sticky self-start services-sticky"
            id="services-panel"
        >
            <div class="w-fit h-fit mb-12">
                <h1 class="text-5xl text-amber-100 font-line-seed">{Services.servicesTitle}</h1>
                <p class="text-lg mt-4 text-secondary">{Services.servicesContent}</p>
            </div>

            <div
                class="w-full h-fit mt-8 py-4 flex flex-col gap-4"
                id="services-list"
            >
                {
                    items.map((item, index) => {
                        const Icon = icons[index] ?? Lightbulb;
                        return (
                            <>
                                <div class="w-7/8 h-0.5 bg-amber-100/20" />
                                <button
                                    type="button"
                                    data-service-item
                                    data-index={index}
                                    aria-pressed={index === defaultIndex ? "true" : "false"}
                                    class:list={[ "service-item w-full h-fit py-4 px-2 flex gap-8 items-center text-left cursor-pointer transition-colors", index === defaultIndex && "is-active", ]}
                                >
                                    <div
                                        data-service-icon
                                        class:list={[ "w-14 h-14 shrink-0 shadow-[6px_6px_0_0_var(--color-amber-300)] flex items-center justify-center text-surface-base transition-colors", index === defaultIndex ? "bg-amber-200" : "bg-amber-100", ]}
                                    >
                                        <Icon class="w-6 h-6" />
                                    </div>
                                    <div class="w-fit h-fit flex flex-col gap-2">
                                        <div class="flex items-center gap-2">
                                            <h2 class="text-3xl text-amber-100">{item.title}</h2>
                                            <span
                                                data-service-badge
                                                class:list={[ "px-2 py-0.5 text-xs font-medium tracking-wide bg-amber-200 text-surface-base transition-opacity", index === defaultIndex ? "opacity-100" : "opacity-0", ]}
                                            >
                                                詳細介紹 →
                                            </span>
                                        </div>
                                        <p class="text-sm text-secondary">{item.description}</p>
                                    </div>
                                </button>
                            </>
                        );
                    })
                }
            </div>
        </div>

        <div
            class="w-1/2 mt-56 p-12 text-primary flex flex-col gap-40"
            id="service-sections"
        >
            {
                items.map((item, index) => (
                    <div
                        data-service-section
                        data-index={index}
                        class:list={["service-section flex flex-col gap-10", index === defaultIndex && "is-active"]}
                    >
                        <div class="flex flex-col gap-3">
                            <span class="w-fit px-3 py-1 text-sm font-medium tracking-wide bg-amber-100 text-surface-base">
                                {String(index + 1).padStart(2, "0")} · {item.tag}
                            </span>
                            <h3 class="text-4xl font-display leading-tight text-amber-100">
                                {item.title}
                            </h3>
                            <p class="text-base text-white/90 leading-relaxed">
                                {item.description}
                            </p>
                        </div>

                        <div class="w-full h-0.5 bg-amber-100/30" />

                        <div class="flex flex-col gap-4">
                            <h4 class="text-xl font-medium text-amber-100">我們會幫你做什麼</h4>
                            <ul class="flex flex-col gap-3 text-sm text-secondary">
                                {
                                    item.bullets.map((bullet) => (
                                        <li class="flex gap-3 items-start">
                                            <span class="mt-2 w-2 h-2 shrink-0 bg-amber-100 shadow-[2px_2px_0_0_var(--color-amber-300)]" />
                                            <span>{bullet}</span>
                                        </li>
                                    ))
                                }
                            </ul>
                        </div>

                        <div class="flex flex-col gap-4">
                            <h4 class="text-xl font-medium text-amber-100">適用場景</h4>
                            <div class="flex flex-wrap gap-2">
                                {
                                    item.scenarios.map((scenario) => (
                                        <span class="px-3 py-1.5 text-sm text-surface-base bg-white border border-surface-base/20">
                                            {scenario}
                                        </span>
                                    ))
                                }
                            </div>
                        </div>
                    </div>
                ))
            }

            <div class="pt-4 flex flex-col gap-4">
                <div class="p-5 bg-surface-raised border border-amber-100/20 text-primary flex flex-col gap-3">
                    <p class="text-sm text-amber-100">{whyUs.title}</p>
                    {
                        whyUs.paragraphs.map((paragraph) => (
                            <p class="text-sm text-secondary leading-relaxed">
                                {paragraph}
                            </p>
                        ))
                    }
                </div>
                <NotchButton
                    as="a"
                    href="#contact"
                    color="var(--color-amber-100)"
                    class="w-fit text-amber-100 font-medium"
                >
                    <MessageSquare class="w-4 h-4" />
                    聊聊你的需求
                </NotchButton>
            </div>
        </div>
    </div>
</section>

<style>
    .trans-hero::after {
        content: "";
        position: absolute;
        top: -4px;
        right: 0;
        height: 4px;
        width: 100%;
        background-color: var(--color-amber-100);
        z-index: -1;
    }

    .services-sticky {
        top: calc(50dvh - var(--services-sticky-height, 0px) / 2);
    }

    .service-item:hover:not(.is-active) {
        background-color: rgba(255, 221, 138, 0.05);
    }

    .service-item.is-active {
        background-color: rgba(255, 221, 138, 0.05);
    }

    .service-section {
        opacity: 0.35;
        transform: translateY(6px);
        transition:
            opacity 300ms ease,
            transform 300ms cubic-bezier(0.4, 0, 0.2, 1);
    }

    .service-section.is-active {
        opacity: 1;
        transform: translateY(0);
    }
</style>

<script>
    const panel = document.getElementById("services-panel");
    const buttons = Array.from(
        document.querySelectorAll<HTMLButtonElement>("[data-service-item]"),
    );
    const sections = Array.from(
        document.querySelectorAll<HTMLElement>("[data-service-section]"),
    );

    if (panel) {
        const setStickyHeight = () => {
            panel.style.setProperty(
                "--services-sticky-height",
                `${panel.getBoundingClientRect().height}px`,
            );
        };

        const resizeObserver = new ResizeObserver(setStickyHeight);
        resizeObserver.observe(panel);
        setStickyHeight();
    }

    let activeIndex = -1;

    const applyActive = (index: number) => {
        if (index === activeIndex) return;
        activeIndex = index;

        for (const button of buttons) {
            const buttonIndex = Number(button.dataset.index);
            const isActive = buttonIndex === index;

            button.classList.toggle("is-active", isActive);
            button.setAttribute("aria-pressed", String(isActive));

            const icon = button.querySelector("[data-service-icon]");
            icon?.classList.toggle("bg-amber-200", isActive);
            icon?.classList.toggle("bg-amber-100", !isActive);

            const badge = button.querySelector("[data-service-badge]");
            badge?.classList.toggle("opacity-100", isActive);
            badge?.classList.toggle("opacity-0", !isActive);
        }

        for (const section of sections) {
            const sectionIndex = Number(section.dataset.index);
            section.classList.toggle("is-active", sectionIndex === index);
        }
    };

    let ticking = false;

    const updateActiveFromScroll = () => {
        ticking = false;
        if (sections.length === 0) return;

        const activeLine = window.innerHeight * 0.5;
        let closestIndex = 0;
        let closestDistance = Number.POSITIVE_INFINITY;

        sections.forEach((section, index) => {
            const rect = section.getBoundingClientRect();
            const distance = Math.abs(rect.top + rect.height / 2 - activeLine);

            if (distance < closestDistance) {
                closestDistance = distance;
                closestIndex = index;
            }
        });

        applyActive(closestIndex);
    };

    const requestUpdate = () => {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(updateActiveFromScroll);
    };

    updateActiveFromScroll();
    window.addEventListener("scroll", requestUpdate, { passive: true });
    window.addEventListener("resize", requestUpdate);

    for (const button of buttons) {
        button.addEventListener("click", () => {
            const index = Number(button.dataset.index);
            const target = sections[index];
            if (!target) return;

            target.scrollIntoView({ behavior: "smooth", block: "center" });
        });
    }
</script>

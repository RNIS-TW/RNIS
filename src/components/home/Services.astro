---
import config from "@content/home.json";

const { Services } = config;
const { highlight, whyUs } = Services;
---

<script>
    const services = document.getElementById("services-panel");

    if (services) {
        const servicesHeight = services.offsetHeight;
        const viewHeight = window.innerHeight;

        const sitckyTopOffset = (viewHeight - servicesHeight) / 2;

        services.style.top = `${sitckyTopOffset}px`;
    }

</script>

<section
    id="services"
    class="w-full h-fit bg-jet-black relative trans-hero"
>
    <div class="container px-16 mx-auto p-16 h-fit flex gap-8 items-start">
        <div
            class="w-1/2 py-8 mt-8 sticky self-start"
            id="services-panel"
        >
            <div class="w-fit h-fit mb-12">
                <h1 class="text-7xl text-alice-blue">{Services.servicesTitle}</h1>
                <p class="text-xl mt-4 text-powder-blue">{Services.servicesContent}</p>
            </div>

            <div class="w-full h-fit mt-8 py-4 flex flex-col gap-4">
                {
                    Services.items.map((item, index) => (
                        <>
                            <div class="w-7/8 h-0.5 bg-icy-blue/20" />
                            <div class="w-full h-fit py-4 px-2 flex gap-8 items-center">
                                <div class="w-14 h-14 shrink-0 bg-icy-blue shadow-[6px_6px_0_0_#66849F] flex items-center justify-center text-2xl text-ink-black font-display">
                                    {index + 1}
                                </div>
                                <div class="w-fit h-fit flex flex-col gap-2">
                                    <h2 class="text-4xl text-alice-blue">{item.title}</h2>
                                    <p class="text-lg text-powder-blue">{item.description}</p>
                                </div>
                            </div>
                        </>
                    ))
                }
            </div>
        </div>

        <div class="w-1/2 mt-56 p-12 text-alice-blue flex flex-col gap-10">
            <div class="flex flex-col gap-3">
                <span class="w-fit px-3 py-1 text-sm font-medium tracking-wide bg-icy-blue text-ink-black">
                    {highlight.tag}
                </span>
                <h3 class="text-4xl font-display leading-tight">{highlight.title}</h3>
                <p class="text-lg text-powder-blue/90 leading-relaxed">
                    {highlight.description}
                </p>
            </div>

            <div class="w-full h-0.5 bg-icy-blue/30"></div>

            <div class="flex flex-col gap-4">
                <h4 class="text-xl font-medium">我們會幫你做什麼</h4>
                <ul class="flex flex-col gap-3 text-base text-powder-blue">
                    {
                        highlight.bullets.map((bullet) => (
                            <li class="flex gap-3 items-start">
                                <span class="mt-2 w-2 h-2 shrink-0 bg-icy-blue shadow-[2px_2px_0_0_#66849F]" />
                                <span>{bullet}</span>
                            </li>
                        ))
                    }
                </ul>
            </div>

            <div class="flex flex-col gap-4">
                <h4 class="text-xl font-medium">適用場景</h4>
                <div class="flex flex-wrap gap-2">
                    {
                        highlight.scenarios.map((scenario) => (
                            <span class="px-3 py-1.5 text-sm text-ink-black bg-alice-blue border border-powder-blue/40">
                                {scenario}
                            </span>
                        ))
                    }
                </div>
            </div>

            <div class="mt-auto pt-4 flex flex-col gap-4">
                <div class="p-5 bg-ink-black text-alice-blue flex flex-col gap-3">
                    <p class="text-sm text-icy-blue">{whyUs.title}</p>
                    {
                        whyUs.paragraphs.map((paragraph) => (
                            <p class="text-sm text-powder-blue leading-relaxed">
                                {paragraph}
                            </p>
                        ))
                    }
                </div>
                <a
                    href="#contact"
                    class="inline-flex w-fit items-center gap-2 px-5 py-3 bg-icy-blue text-ink-black font-medium shadow-[4px_4px_0_0_#66849F] hover:translate-x-0.5 hover:translate-y-0.5 hover:shadow-[2px_2px_0_0_#66849F] transition-all"
                >
                    聊聊你的需求
                    <span aria-hidden="true">→</span>
                </a>
            </div>
        </div>
    </div>
</section>

<style>
    .trans-hero::after {
        content: "";
        position: absolute;
        top: -4px;
        right: 0;
        height: 4px;
        width: 100%;
        background-color: var(--color-icy-blue);
        z-index: -1;
    }
</style>

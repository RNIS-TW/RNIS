---
import config from "@content/home.json";

import EasingGradient from "@components/util/easingGradient.astro";
---

<section class="w-full h-screen bg-jet-black">
    <div class="container px-16 mx-auto py-32 w-full h-fit">
        <div class="w-full h-fit flex justify-between items-end">
            <div class="flex flex-col w-full gap-4">
                <!-- <span class="w-24 h-1 bg-icy-blue"></span> -->
                <div class="flex items-start justify-between">
                    <h1 class="text-7xl text-alice-blue">成功案例</h1>
                    <p class="text-xl max-w-60 text-powder-blue">這裡是我們的成功案例</p>
                </div>
                <a
                    href="#contact"
                    class="w-fit h-fit px-4 py-2 ml-auto bg-ink-black text-alice-blue border-2 border-icy-blue duration-00 contact"
                >
                    <p class="text-lg">聯絡我們</p>
                </a>
            </div>
        </div>

        <div class="w-full h-fit mt-24 flex">
            <div class="h-[50vh] flex-1 border border-air-force-blue relative p-4">
                
                <div class="w-full h-auto aspect-video absolute top-0 left-0 p-2">
                    <img
                        src="https://truth.bahamut.com.tw/s01/202607/forum/18673/19726c638b4bf5323373b9372b12b1a9.JPG"
                        alt="testing"
                        class="w-full h-full object-cover"
                    />

                    <EasingGradient
                        width="100%"
                        height="100%"
                        deg={0}
                        color="var(--color-jet-black)"
                        to="transparent"
                        ease="in-out"
                        stops={4}
                        class="absolute inset-0"
                    />
                </div>

                <div class="relative w-full h-full p-4">
                    <div class="w-full h-1/2 flex flex-col gap-2">
                        <div class="flex gap-4">
                            <div class="w-2 h-15 bg-cool-sky" />
                            <h2 class="text-6xl text-alice-blue">TESTING</h2>
                        </div>
                        <p class="text-xl text-alice-blue">
                            與台灣知名實況主 <a
                                href="https://www.youtube.com/@%E9%BE%8DDragonL/featured"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-alice-blue underline underline-offset-2 duration-300 hover:text-cool-sky"
                            >DragonL</a
                            > 合作
                        </p>
                    </div>
                    <div class="w-full h-1/2 flex flex-col gap-2">
                        <div class="flex-1">
                            <p class="text-air-force-blue">機哩瓜啦機哩瓜啦機哩瓜啦機哩瓜啦機哩瓜啦機哩瓜啦機哩瓜啦機哩瓜啦機哩瓜啦機哩瓜啦</p>
                        </div>
                        <div class="w-full h-fit flex items-end justify-between">
                            <div class="flex w-fit h-fit items-end justify-start">
                                <a
                                    href="https://www.google.com"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="w-fit h-fit px-4 py-2 bg-yale-blue border border-icy-blue button duration-100 relative"
                                >
                                    <p class="text-sm text-alice-blue">前往泥土</p>
                                </a>
                                <a
                                    href="https://www.google.com"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="w-fit h-fit px-4 py-2 bg-yale-blue border border-icy-blue button duration-100 relative"
                                >
                                    <p class="text-sm text-alice-blue">前往泥土</p>
                                </a>
                            </div>
                            <span class="text-xs text-air-force-blue">2024.06.01</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="h-[50vh] flex-1 border border-l-0 border-air-force-blue">
            </div>
        </div>
    </div>
</section>

<style>
    .contact {
        box-shadow: 4px 4px 0 0 var(--color-air-force-blue);
    }

    .contact:hover {
        transform: translateX(0.125rem) translateY(0.125rem);
        box-shadow: 2px 2px 0 0 var(--color-air-force-blue);
    }
    
    .button:hover {
        transform: scale(1.05) translateY(-1px);
        z-index: 10;
    }
</style>

---
import EasingGradient from "@utils/easingGradient.astro";
import NotchButton from "@utils/NotchButton.astro";

import { ExternalLink, ChevronLeft, ChevronRight } from "@lucide/astro/icons";

import content from "@content/home.json";
import projectsData from "@config/projects.json";

interface ProjectItem {
    title: string;
    images: string[];
    collaboratorName: string;
    collaboratorUrl: string;
    description: string;
    dateRange: string;
    links: { label: string; href: string }[];
}

const { Projects } = content;
const projects = projectsData as ProjectItem[];
---

<section id="projects" class="w-full bg-surface-base">
    <div class="container mx-auto px-6 sm:px-10 lg:px-16 py-16 lg:py-32 w-full h-fit">
        <div class="w-full h-fit mb-10 lg:mb-16 flex flex-col sm:flex-row items-start sm:items-end justify-between gap-6">
            <div class="flex flex-col gap-4">
                <h1 class="text-3xl sm:text-4xl lg:text-5xl text-amber-100 font-line-seed">{Projects.title}</h1>
                <p class="text-base sm:text-lg text-secondary">
                    {Projects.description}
                </p>
            </div>

            <div class="flex flex-wrap items-center gap-4">
                <NotchButton
                    as="a"
                    href="#contact"
                    color="var(--color-amber-100)"
                    class="projects-cta text-primary text-base"
                >
                    {Projects.viewMoreLabel}
                </NotchButton>
                <NotchButton
                    as="a"
                    href="#contact"
                    color="var(--color-amber-100)"
                    class="projects-cta text-primary text-base"
                >
                    {Projects.contactLabel}
                </NotchButton>
            </div>
        </div>

        <div class="w-full h-fit mt-8 grid grid-cols-1 lg:grid-cols-2 gap-8">
            {
                projects.map((project) => (
                    <div class="project-card group flex flex-col h-full bg-surface-raised border border-amber-100/20">
                        <div
                            class="carousel w-full aspect-video relative overflow-hidden"
                            data-carousel
                        >
                            <div
                                class="carousel__track flex h-full"
                                data-carousel-track
                            >
                                {project.images.map((src, index) => (
                                    <div class="carousel__slide" data-carousel-slide>
                                        <img
                                            src={src}
                                            alt={`${project.title} ${index + 1}`}
                                            class="w-full h-full object-cover"
                                            loading="lazy"
                                            decoding="async"
                                        />
                                    </div>
                                ))}
                            </div>

                            <EasingGradient
                                width="100%"
                                height="40%"
                                deg={0}
                                color="var(--color-surface-raised)"
                                to="transparent"
                                ease="in-out"
                                stops={4}
                                class="absolute inset-x-0 bottom-0 pointer-events-none"
                            />

                            {project.images.length > 1 && (
                                <>
                                    <button
                                        type="button"
                                        class="carousel__arrow carousel__arrow--prev"
                                        data-carousel-prev
                                        aria-label="上一張圖片"
                                    >
                                        <ChevronLeft class="w-4 h-4" />
                                    </button>
                                    <button
                                        type="button"
                                        class="carousel__arrow carousel__arrow--next"
                                        data-carousel-next
                                        aria-label="下一張圖片"
                                    >
                                        <ChevronRight class="w-4 h-4" />
                                    </button>
                                    <div class="carousel__dots">
                                        {project.images.map((_, index) => (
                                            <button
                                                type="button"
                                                class:list={["carousel__dot", index === 0 && "is-active"]}
                                                data-carousel-dot
                                                aria-label={`前往第 ${index + 1} 張圖片`}
                                            />
                                        ))}
                                    </div>
                                </>
                            )}
                        </div>

                        <div class="relative flex flex-col flex-1 gap-4 p-5 sm:p-6">
                            <div class="flex flex-col gap-3">
                                <div class="flex items-start gap-3">
                                    <div class="w-1.5 h-7 sm:h-8 mt-1 shrink-0 bg-amber-200" />
                                    <h2 class="text-xl sm:text-2xl lg:text-3xl text-amber-100 leading-tight">
                                        {project.title}
                                    </h2>
                                </div>
                                <p class="text-sm sm:text-base text-secondary pl-4.5">
                                    與台灣知名實況主{" "}
                                    <a
                                        href={project.collaboratorUrl}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="text-amber-200 underline underline-offset-2 decoration-amber-200/50 duration-300 hover:text-amber-100"
                                    >
                                        {project.collaboratorName}
                                    </a>{" "}
                                    合作
                                </p>
                                <p class="text-sm text-secondary leading-relaxed pl-4.5">
                                    {project.description}
                                </p>
                            </div>

                            <div class="w-full h-px bg-amber-100/15 mt-auto" />

                            <div class="w-full h-fit flex flex-col sm:flex-row items-start sm:items-end justify-between gap-4">
                                <div class="flex w-fit h-fit flex-wrap items-end justify-start gap-2">
                                    {project.links.map((link, index) => (
                                        <NotchButton
                                            as="a"
                                            href={link.href}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            color="var(--color-amber-100)"
                                            notch="6px"
                                            corners={ index % 2 === 0 ? { topLeft: true, bottomRight: true, topRight: false, bottomLeft: false, } : { topLeft: false, bottomRight: false, topRight: true, bottomLeft: true, } }
                                            class="projects-cta text-primary text-sm"
                                        >
                                            {link.label}
                                            <ExternalLink class="w-4 h-4" />
                                        </NotchButton>
                                    ))}
                                </div>
                                <span class="text-xs tracking-wide text-amber-300 shrink-0">
                                    {project.dateRange}
                                </span>
                            </div>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<style>
    .project-card {
        overflow: hidden;
        box-shadow: 0 0 0 0 transparent;
        transition:
            transform 250ms cubic-bezier(0.4, 0, 0.2, 1),
            box-shadow 250ms cubic-bezier(0.4, 0, 0.2, 1),
            border-color 250ms ease;
    }

    .project-card:hover {
        transform: translate(-4px, -4px);
        box-shadow: 8px 8px 0 0 var(--color-amber-300);
        border-color: var(--color-amber-100);
    }

    .projects-cta :global(.notch-button__hole) {
        transition: background-color 250ms ease;
    }

    .projects-cta :global(.notch-button__content) {
        transition: color 250ms ease;
    }

    .projects-cta:hover :global(.notch-button__hole) {
        background: var(--notch-color);
    }

    .projects-cta:hover :global(.notch-button__content) {
        color: var(--notch-fill);
    }

    .carousel__track {
        will-change: transform;
        transition: transform 600ms cubic-bezier(0.4, 0, 0.2, 1);
    }

    .carousel__slide {
        flex: 0 0 100%;
        height: 100%;
    }

    .carousel__arrow {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 2rem;
        background: rgba(21, 28, 42, 0.6);
        color: var(--text-primary);
        border: 1px solid var(--color-amber-100);
        cursor: pointer;
        opacity: 0;
        transition:
            opacity 200ms ease,
            background-color 200ms ease;
    }

    .carousel:hover .carousel__arrow {
        opacity: 1;
    }

    .carousel__arrow:hover {
        background: var(--color-amber-100);
        color: var(--color-surface-base);
    }

    .carousel__arrow--prev {
        left: 0.5rem;
    }

    .carousel__arrow--next {
        right: 0.5rem;
    }

    .carousel__dots {
        position: absolute;
        bottom: 0.5rem;
        left: 50%;
        transform: translateX(-50%);
        z-index: 2;
        display: flex;
        gap: 0.4rem;
    }

    .carousel__dot {
        width: 0.5rem;
        height: 0.5rem;
        border: 1px solid var(--color-amber-100);
        background: transparent;
        padding: 0;
        cursor: pointer;
        transition: background-color 200ms ease;
    }

    .carousel__dot.is-active {
        background: var(--color-amber-100);
    }
</style>

<script>
    const init = () => {
        const carousels = document.querySelectorAll<HTMLElement>("[data-carousel]");
        if (carousels.length === 0) return;

        const controller = new AbortController();
        const { signal } = controller;
        const timers: ReturnType<typeof setInterval>[] = [];

        for (const carousel of carousels) {
            const track = carousel.querySelector<HTMLElement>(
                "[data-carousel-track]",
            );
            const slides = Array.from(
                carousel.querySelectorAll<HTMLElement>("[data-carousel-slide]"),
            );
            const dots = Array.from(
                carousel.querySelectorAll<HTMLElement>("[data-carousel-dot]"),
            );
            const prevButton = carousel.querySelector<HTMLButtonElement>(
                "[data-carousel-prev]",
            );
            const nextButton = carousel.querySelector<HTMLButtonElement>(
                "[data-carousel-next]",
            );

            if (!track || slides.length <= 1) continue;

            let activeIndex = 0;
            let timer: ReturnType<typeof setInterval> | undefined;

            const goTo = (index: number) => {
                activeIndex = (index + slides.length) % slides.length;

                track.style.transform = `translateX(-${activeIndex * 100}%)`;
                dots.forEach((dot, i) => {
                    dot.classList.toggle("is-active", i === activeIndex);
                });
            };

            const startAutoplay = () => {
                timer = setInterval(() => goTo(activeIndex + 1), 4000);
                timers.push(timer);
            };
            const stopAutoplay = () => {
                clearInterval(timer);
            };

            prevButton?.addEventListener(
                "click",
                () => goTo(activeIndex - 1),
                { signal },
            );
            nextButton?.addEventListener(
                "click",
                () => goTo(activeIndex + 1),
                { signal },
            );
            dots.forEach((dot, i) => {
                dot.addEventListener("click", () => goTo(i), { signal });
            });

            carousel.addEventListener("mouseenter", stopAutoplay, { signal });
            carousel.addEventListener("mouseleave", startAutoplay, { signal });

            startAutoplay();
        }

        document.addEventListener(
            "astro:before-swap",
            () => {
                controller.abort();
                timers.forEach(clearInterval);
            },
            { once: true },
        );
    };

    // This script is a processed module, and browsers only ever evaluate a
    // given module URL once — re-inserting it on later navigations is a
    // no-op. astro:page-load fires once for the initial load and again
    // after every subsequent navigation, so binding init() to it (and only
    // it) re-queries the carousels against the fresh DOM every time,
    // without double-running on load.
    document.addEventListener("astro:page-load", init);
</script>

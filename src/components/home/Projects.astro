---
import EasingGradient from "@utils/easingGradient.astro";
import NotchButton from "@utils/NotchButton.astro";

import { ExternalLink, ChevronLeft, ChevronRight } from "@lucide/astro/icons";

import content from "@content/home.json";
import projectsData from "@config/projects.json";

interface ProjectItem {
    title: string;
    images: string[];
    collaboratorName: string;
    collaboratorUrl: string;
    description: string;
    dateRange: string;
    links: { label: string; href: string }[];
}

const { Projects } = content;
const projects = projectsData as ProjectItem[];
---

<section id="projects" class="w-full bg-surface-base">
    <div class="container px-16 mx-auto py-32 w-full h-fit">
        <div class="w-full h-fit mb-16 flex items-end justify-between gap-4">
            <div class="flex flex-col gap-4">
                <h1 class="text-5xl text-amber-100 font-line-seed">{Projects.title}</h1>
                <p class="text-lg text-secondary">
                    {Projects.description}
                </p>
            </div>

            <div class="flex items-center gap-4">
                <NotchButton
                    as="a"
                    href="#contact"
                    color="var(--color-amber-100)"
                    class="projects-cta text-primary text-base"
                >
                    {Projects.viewMoreLabel}
                </NotchButton>
                <NotchButton
                    as="a"
                    href="#contact"
                    color="var(--color-amber-100)"
                    class="projects-cta text-primary text-base"
                >
                    {Projects.contactLabel}
                </NotchButton>
            </div>
        </div>

        <div class="w-full h-fit mt-8 grid grid-cols-1 lg:grid-cols-2 gap-6">
            {
                projects.map((project) => (
                    <div class="project-card h-[50vh] border-2 border-amber-300 relative p-4">
                        <div
                            class="carousel w-full h-auto aspect-video absolute top-0 left-0 overflow-hidden"
                            data-carousel
                        >
                            <div
                                class="carousel__track flex h-full"
                                data-carousel-track
                            >
                                {project.images.map((src, index) => (
                                    <div class="carousel__slide" data-carousel-slide>
                                        <img
                                            src={src}
                                            alt={`${project.title} ${index + 1}`}
                                            class="w-full h-full object-cover"
                                            loading="lazy"
                                            decoding="async"
                                        />
                                    </div>
                                ))}
                            </div>

                            <EasingGradient
                                width="100%"
                                height="100%"
                                deg={0}
                                color="var(--color-surface-base)"
                                to="transparent"
                                ease="in-out"
                                stops={4}
                                class="absolute inset-0"
                            />
                        </div>

                        <div class="relative w-full h-full p-4">
                            <div class="w-full h-1/2 flex flex-col gap-2">
                                <div class="flex gap-4">
                                    <div class="w-2 h-10 bg-amber-200" />
                                    <h2 class="text-4xl text-amber-100">
                                        {project.title}
                                    </h2>
                                </div>
                                <p class="text-lg text-primary">
                                    與台灣知名實況主{" "}
                                    <a
                                        href={project.collaboratorUrl}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="text-primary underline underline-offset-2 duration-300 hover:text-amber-200"
                                    >
                                        {project.collaboratorName}
                                    </a>{" "}
                                    合作
                                </p>
                            </div>
                            <div class="w-full h-1/2 flex flex-col items-start justify-end gap-8">
                                <div class="max-w-md">
                                    <p class="text-sm text-primary">
                                        {project.description}
                                    </p>
                                </div>
                                <div class="w-full h-fit flex items-end justify-between">
                                    <div class="flex w-fit h-fit items-end justify-start gap-2">
                                        {project.links.map((link, index) => (
                                            <NotchButton
                                                as="a"
                                                href={link.href}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                color="var(--color-amber-100)"
                                                notch="6px"
                                                corners={ index % 2 === 0 ? { topLeft: true, bottomRight: true, topRight: false, bottomLeft: false, } : { topLeft: false, bottomRight: false, topRight: true, bottomLeft: true, } }
                                                class="projects-cta text-primary text-sm"
                                            >
                                                {link.label}
                                                <ExternalLink class="w-4 h-4" />
                                            </NotchButton>
                                        ))}
                                    </div>
                                    <span class="text-xs text-amber-300">
                                        {project.dateRange}
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<style>
    .project-card {
        transition:
            transform 300ms cubic-bezier(0.4, 0, 0.2, 1),
            border-color 300ms ease;
    }

    .project-card:hover {
        transform: translateY(-0.3rem);
        border-color: var(--color-amber-100);
    }

    .projects-cta :global(.notch-button__hole) {
        transition: background-color 250ms ease;
    }

    .projects-cta :global(.notch-button__content) {
        transition: color 250ms ease;
    }

    .projects-cta:hover :global(.notch-button__hole) {
        background: var(--notch-color);
    }

    .projects-cta:hover :global(.notch-button__content) {
        color: var(--notch-fill);
    }

    .carousel__track {
        will-change: transform;
        transition: transform 600ms cubic-bezier(0.4, 0, 0.2, 1);
    }

    .carousel__slide {
        flex: 0 0 100%;
        height: 100%;
    }

    .carousel__arrow {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 2rem;
        background: rgba(21, 28, 42, 0.6);
        color: var(--text-primary);
        border: 1px solid var(--color-amber-100);
        cursor: pointer;
        opacity: 0;
        transition:
            opacity 200ms ease,
            background-color 200ms ease;
    }

    .carousel:hover .carousel__arrow {
        opacity: 1;
    }

    .carousel__arrow:hover {
        background: var(--color-amber-100);
        color: var(--color-surface-base);
    }

    .carousel__arrow--prev {
        left: 0.5rem;
    }

    .carousel__arrow--next {
        right: 0.5rem;
    }

    .carousel__dots {
        position: absolute;
        bottom: 0.5rem;
        left: 50%;
        transform: translateX(-50%);
        z-index: 2;
        display: flex;
        gap: 0.4rem;
    }

    .carousel__dot {
        width: 0.5rem;
        height: 0.5rem;
        border: 1px solid var(--color-amber-100);
        background: transparent;
        padding: 0;
        cursor: pointer;
        transition: background-color 200ms ease;
    }

    .carousel__dot.is-active {
        background: var(--color-amber-100);
    }
</style>

<script>
    const carousels = document.querySelectorAll<HTMLElement>("[data-carousel]");

    for (const carousel of carousels) {
        const track = carousel.querySelector<HTMLElement>(
            "[data-carousel-track]",
        );
        const slides = Array.from(
            carousel.querySelectorAll<HTMLElement>("[data-carousel-slide]"),
        );
        const dots = Array.from(
            carousel.querySelectorAll<HTMLElement>("[data-carousel-dot]"),
        );
        const prevButton = carousel.querySelector<HTMLButtonElement>(
            "[data-carousel-prev]",
        );
        const nextButton = carousel.querySelector<HTMLButtonElement>(
            "[data-carousel-next]",
        );

        if (!track || slides.length <= 1) continue;

        let activeIndex = 0;
        let timer: ReturnType<typeof setInterval> | undefined;

        const goTo = (index: number) => {
            activeIndex = (index + slides.length) % slides.length;

            track.style.transform = `translateX(-${activeIndex * 100}%)`;
            dots.forEach((dot, i) => {
                dot.classList.toggle("is-active", i === activeIndex);
            });
        };

        const startAutoplay = () => {
            timer = setInterval(() => goTo(activeIndex + 1), 4000);
        };
        const stopAutoplay = () => {
            clearInterval(timer);
        };

        prevButton?.addEventListener("click", () => {
            goTo(activeIndex - 1);
        });
        nextButton?.addEventListener("click", () => {
            goTo(activeIndex + 1);
        });
        dots.forEach((dot, i) => {
            dot.addEventListener("click", () => goTo(i));
        });

        carousel.addEventListener("mouseenter", stopAutoplay);
        carousel.addEventListener("mouseleave", startAutoplay);

        startAutoplay();
    }
</script>

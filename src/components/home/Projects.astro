---
import config from "@content/home.json";


---

<section class="w-full h-screen bg-jet-black">
    <div class="container px-16 mx-auto py-16 w-full h-fit">

        <div class="w-full h-fit flex justify-between items-end">
            <div class="flex flex-col w-full gap-4">
                <span class="w-24 h-1 bg-icy-blue"></span>
                <div class="flex items-start justify-between">
                    <h1 class="text-5xl">成功案例</h1>
                    <p class="text-xl">這裡是我們的成功案例</p>
                </div>
                <a href="" class="w-fit h-fit px-4 py-2 ml-auto bg-ink-black text-alice-blue border-2 border-icy-blue duration-300 contact">
                    <p class="text-lg">聯絡我們</p>
                </a>
            </div>
        </div>

        <div class="w-full h-fit mt-16 px-16 flex">

            <div class="h-48 flex-1 border-2 border-air-force-blue">

            </div>
            <div class="h-48 flex-1 border-2 border-air-force-blue">

            </div>
            <div class="h-48 flex-1 border-2 border-air-force-blue">

            </div>


        </div>
    </div>
</section>

<style>

    .contact {
        box-shadow: 5px 5px 0 0 var(--color-air-force-blue);
    }

    .contact:hover {
        transform: translateX(0.125rem) translateY(0.125rem);
        box-shadow: 2px 2px 0 0 var(--color-air-force-blue);
    }



</style>
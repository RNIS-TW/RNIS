---
import config from "@content/home.json";

const { Contact: contact } = config;
const initialChannel = contact.channels.find((channel) => channel.available) ?? contact.channels[0];
---

<section
    id="contact"
    aria-labelledby="contact-title"
    class="relative isolate w-full overflow-hidden bg-ink-black px-5 py-16 text-alice-blue sm:px-8 sm:py-20 lg:px-[clamp(3rem,6vw,7rem)] lg:py-[clamp(5rem,9vw,8rem)]"
>
    <div class="relative mx-auto max-w-[100rem]">
        <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 -z-10 opacity-70 [background-image:radial-gradient(circle_at_8%_20%,rgba(118,186,255,.15),transparent_24rem),radial-gradient(circle_at_92%_82%,rgba(190,248,184,.07),transparent_22rem)]"
        ></div>

        <div class="grid gap-14 lg:grid-cols-[minmax(0,1.7fr)_minmax(19rem,.72fr)] lg:gap-0">
            <div class="min-w-0 lg:pr-[clamp(3rem,6vw,7rem)]">
                <header>
                    <p class="font-mono text-[0.65rem] font-semibold tracking-[0.2em] text-cool-sky sm:text-xs">
                        {contact.eyebrow}
                    </p>
                    <h2
                        id="contact-title"
                        class="mt-6 font-display text-[clamp(3.25rem,7vw,7rem)] font-medium leading-[0.82] tracking-[-0.055em] text-alice-blue"
                    >{contact.title}</h2>
                    <p class="mt-6 max-w-2xl text-sm leading-6 text-icy-blue/72 sm:text-base sm:leading-7">
                        {contact.description}
                    </p>
                </header>

                <div class="mt-10" data-contact-switcher>
                    <div
                        class="flex flex-wrap gap-2"
                        role="tablist"
                        aria-label="聯絡管道"
                    >
                        {contact.channels.map((channel) => (
                            <button
                                type="button"
                                role="tab"
                                id={`contact-tab-${channel.id}`}
                                aria-controls={`contact-panel-${channel.id}`}
                                aria-selected={channel.id === initialChannel.id ? "true" : "false"}
                                tabindex={channel.id === initialChannel.id ? 0 : -1}
                                data-contact-tab={channel.id}
                                class="group inline-flex min-h-11 items-center gap-3 border border-icy-blue/35 bg-ink-black/70 px-4 py-2.5 font-mono text-[0.68rem] font-semibold tracking-[0.12em] text-icy-blue transition-[border-color,background-color,color,transform] hover:-translate-y-0.5 hover:border-icy-blue/80 hover:text-alice-blue focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cool-sky focus-visible:ring-offset-4 focus-visible:ring-offset-ink-black aria-selected:border-cool-sky aria-selected:bg-cool-sky aria-selected:text-ink-black motion-reduce:transform-none motion-reduce:transition-none"
                            >
                                <span
                                    class="h-1.5 w-1.5 bg-current opacity-65"
                                    aria-hidden="true"
                                ></span>
                                {channel.shortLabel}
                            </button>
                        ))}
                    </div>

                    <div class="relative mt-5 min-h-[19rem] overflow-hidden border border-icy-blue/35 bg-yale-blue/10 p-6 shadow-[8px_8px_0_0_rgba(64,98,135,.24)] sm:min-h-[20rem] sm:p-9">
                        <span
                            aria-hidden="true"
                            class="absolute right-5 top-4 font-mono text-[0.58rem] tracking-[0.16em] text-powder-blue/40"
                        >
                            OPEN CHANNEL
                        </span>

                        {contact.channels.map((channel) => (
                            <div
                                id={`contact-panel-${channel.id}`}
                                role="tabpanel"
                                aria-labelledby={`contact-tab-${channel.id}`}
                                data-contact-panel={channel.id}
                                hidden={channel.id !== initialChannel.id}
                                class="flex min-h-[15rem] flex-col justify-end sm:min-h-[14rem]"
                            >
                                <p class="font-mono text-[0.62rem] tracking-[0.16em] text-powder-blue/60">
                                    {channel.available ? "AVAILABLE / 可聯絡" : "CHANNEL / 管道預留"}
                                </p>
                                <h3 class="mt-4 font-display text-[clamp(2.25rem,4vw,4rem)] font-medium leading-[0.9] tracking-[-0.04em] text-alice-blue">
                                    {channel.title}
                                </h3>
                                <p class="mt-4 max-w-xl text-sm leading-6 text-icy-blue/70 sm:text-base sm:leading-7">
                                    {channel.description}
                                </p>

                                <div class="mt-7 flex flex-wrap items-center gap-4">
                                    {channel.available && channel.href ? (
                                        <a
                                            href={channel.href}
                                            target={channel.id === "mail" ? undefined : "_blank"}
                                            rel={channel.id === "mail" ? undefined : "noreferrer"}
                                            class="group/action inline-flex min-h-12 items-center gap-4 bg-icy-blue px-5 py-3 text-sm font-semibold text-ink-black shadow-[4px_4px_0_0_#406287] transition-[transform,box-shadow] hover:translate-x-0.5 hover:translate-y-0.5 hover:shadow-[2px_2px_0_0_#406287] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cool-sky focus-visible:ring-offset-4 focus-visible:ring-offset-ink-black motion-reduce:transform-none motion-reduce:transition-none"
                                        >
                                            {channel.actionLabel}
                                            <span
                                                class="transition-transform group-hover/action:translate-x-1 motion-reduce:transition-none"
                                                aria-hidden="true"
                                            >→</span>
                                        </a>
                                    ) : (
                                        <span class="inline-flex min-h-12 items-center border border-icy-blue/25 px-5 py-3 font-mono text-xs tracking-[0.12em] text-powder-blue/55">
                                            {channel.actionLabel}
                                        </span>
                                    )}
                                    {channel.address && (
                                        <span class="break-all font-mono text-xs text-powder-blue/65">{channel.address}</span>
                                    )}
                                </div>
                            </div>
                        ))}
                    </div>
                </div>

                <form
                    class="mt-10 border-t border-icy-blue/25 pt-7"
                    data-mailing-form
                    data-recipient={contact.email}
                >
                    <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
                        <div>
                            <p class="font-mono text-[0.62rem] tracking-[0.16em] text-tea-green">
                                {contact.mailing.eyebrow}
                            </p>
                            <h3 class="mt-2 font-display text-2xl font-medium tracking-[-0.025em] text-alice-blue sm:text-3xl">
                                {contact.mailing.title}
                            </h3>
                            <p class="mt-2 max-w-xl text-sm leading-6 text-icy-blue/65">
                                {contact.mailing.description}
                            </p>
                        </div>

                        <div class="flex w-full max-w-xl flex-col gap-3 sm:w-auto sm:min-w-[24rem]">
                            <label class="sr-only" for="contact-mailing-email">電子信箱</label>
                            <div class="flex flex-col gap-2 min-[480px]:flex-row">
                                <input
                                    id="contact-mailing-email"
                                    name="email"
                                    type="email"
                                    autocomplete="email"
                                    required
                                    placeholder={contact.mailing.placeholder}
                                    class="min-h-12 min-w-0 flex-1 border border-icy-blue/35 bg-ink-black/75 px-4 text-sm text-alice-blue outline-none transition-colors placeholder:text-powder-blue/40 focus:border-cool-sky focus:ring-2 focus:ring-cool-sky/35"
                                />
                                <button
                                    type="submit"
                                    class="min-h-12 shrink-0 border border-tea-green bg-tea-green px-5 font-mono text-xs font-semibold tracking-[0.1em] text-ink-black shadow-[4px_4px_0_0_rgba(102,132,159,.8)] transition-[transform,box-shadow] hover:translate-x-0.5 hover:translate-y-0.5 hover:shadow-[2px_2px_0_0_rgba(102,132,159,.8)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-tea-green focus-visible:ring-offset-4 focus-visible:ring-offset-ink-black motion-reduce:transform-none motion-reduce:transition-none"
                                >
                                    {contact.mailing.buttonLabel}
                                </button>
                            </div>
                            <p
                                class="font-mono text-[0.6rem] leading-5 text-powder-blue/50"
                                data-mailing-note
                            >
                                {contact.mailing.note}
                            </p>
                        </div>
                    </div>
                </form>
            </div>

            <aside class="border-t border-icy-blue/30 pt-10 lg:border-l lg:border-t-0 lg:pl-[clamp(3rem,5vw,6rem)] lg:pt-0">
                <p class="font-mono text-[0.65rem] font-semibold tracking-[0.2em] text-jasmine sm:text-xs">
                    {contact.discord.eyebrow}
                </p>
                <h3 class="mt-5 font-display text-[clamp(2.3rem,4vw,4rem)] font-medium leading-[0.9] tracking-[-0.04em] text-alice-blue">
                    {contact.discord.title}
                </h3>
                <p class="mt-5 text-sm leading-6 text-icy-blue/68">
                    {contact.discord.description}
                </p>

                <div class="mt-8 overflow-hidden border border-icy-blue/35 bg-yale-blue/12 p-3 shadow-[8px_8px_0_0_rgba(64,98,135,.22)]">
                    {contact.discord.embedUrl ? (
                        <iframe
                            title="RNIS Discord 社群"
                            src={contact.discord.embedUrl}
                            width="350"
                            height="500"
                            allowtransparency="true"
                            sandbox="allow-popups allow-popups-to-escape-sandbox allow-same-origin allow-scripts"
                            class="h-[25rem] w-full border-0"
                        ></iframe>
                    ) : (
                        <div class="relative flex min-h-[25rem] flex-col overflow-hidden border border-dashed border-icy-blue/30 bg-ink-black/70 p-5">
                            <div
                                aria-hidden="true"
                                class="absolute inset-0 opacity-40 [background-image:linear-gradient(rgba(186,221,254,.055)_1px,transparent_1px),linear-gradient(90deg,rgba(186,221,254,.055)_1px,transparent_1px)] [background-size:32px_32px]"
                            ></div>

                            <div class="relative flex items-center gap-3 border-b border-icy-blue/20 pb-4">
                                <span class="grid h-10 w-10 place-items-center bg-[#5865f2] font-mono text-xs font-bold text-white shadow-[3px_3px_0_0_rgba(186,221,254,.16)]">DC</span>
                                <div>
                                    <p class="text-sm font-semibold text-alice-blue">RNIS Community</p>
                                    <p class="mt-0.5 font-mono text-[0.58rem] tracking-[0.12em] text-powder-blue/50">SERVER PREVIEW</p>
                                </div>
                            </div>

                            <div
                                class="relative my-auto space-y-3 py-8"
                                aria-hidden="true"
                            >
                                <div class="flex items-center gap-3"><span class="h-8 w-8 rounded-full bg-powder-blue/20"></span><span class="h-2 w-3/5 bg-icy-blue/15"></span></div>
                                <div class="flex items-center gap-3"><span class="h-8 w-8 rounded-full bg-jasmine/20"></span><span class="h-2 w-2/5 bg-icy-blue/15"></span></div>
                                <div class="flex items-center gap-3"><span class="h-8 w-8 rounded-full bg-tea-green/20"></span><span class="h-2 w-4/5 bg-icy-blue/15"></span></div>
                            </div>

                            <p class="relative border-t border-icy-blue/20 pt-4 text-xs leading-5 text-powder-blue/55">
                                {contact.discord.placeholder}
                            </p>
                        </div>
                    )}
                </div>

                {contact.discord.inviteUrl ? (
                    <a
                        href={contact.discord.inviteUrl}
                        target="_blank"
                        rel="noreferrer"
                        class="mt-6 inline-flex min-h-11 w-full items-center justify-between border border-icy-blue/40 px-4 py-2.5 font-mono text-xs font-semibold tracking-[0.1em] text-icy-blue transition-colors hover:border-[#7983f5] hover:bg-[#5865f2]/15 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cool-sky"
                    >
                        {contact.discord.buttonLabel}<span aria-hidden="true">↗</span>
                    </a>
                ) : (
                    <p class="mt-5 font-mono text-[0.6rem] leading-5 tracking-[0.08em] text-powder-blue/45">
                        DISCORD INVITE URL PENDING
                    </p>
                )}
            </aside>
        </div>

        <footer class="mt-14 flex flex-col gap-3 border-t border-icy-blue/20 pt-5 font-mono text-[0.6rem] tracking-[0.13em] text-powder-blue/45 sm:flex-row sm:items-center sm:justify-between">
            <span>{contact.footer.left}</span>
            <span>{contact.footer.right}</span>
        </footer>
    </div>
</section>

<script>
    const switchers = document.querySelectorAll<HTMLElement>("[data-contact-switcher]");

    switchers.forEach((switcher) => {
        const tabs = Array.from(switcher.querySelectorAll<HTMLButtonElement>("[data-contact-tab]"));
        const panels = Array.from(switcher.querySelectorAll<HTMLElement>("[data-contact-panel]"));

        const selectTab = (tab: HTMLButtonElement, focus = false) => {
            const selectedId = tab.dataset.contactTab;

            tabs.forEach((item) => {
                const selected = item === tab;
                item.setAttribute("aria-selected", String(selected));
                item.tabIndex = selected ? 0 : -1;
            });

            panels.forEach((panel) => {
                panel.hidden = panel.dataset.contactPanel !== selectedId;
            });

            if (focus) tab.focus();
        };

        tabs.forEach((tab, index) => {
            tab.addEventListener("click", () => selectTab(tab));
            tab.addEventListener("keydown", (event) => {
                if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)) return;
                event.preventDefault();

                const nextIndex = event.key === "Home"
                    ? 0
                    : event.key === "End"
                        ? tabs.length - 1
                        : (index + (event.key === "ArrowRight" ? 1 : -1) + tabs.length) % tabs.length;

                selectTab(tabs[nextIndex], true);
            });
        });
    });

    document.querySelectorAll<HTMLFormElement>("[data-mailing-form]").forEach((form) => {
        form.addEventListener("submit", (event) => {
            event.preventDefault();

            const input = form.elements.namedItem("email");
            if (!(input instanceof HTMLInputElement) || !input.reportValidity()) return;

            const recipient = form.dataset.recipient;
            if (!recipient) return;

            const subject = encodeURIComponent("訂閱 RNIS 消息清單");
            const body = encodeURIComponent(`請將 ${input.value} 加入 RNIS 消息清單。`);
            window.location.href = `mailto:${recipient}?subject=${subject}&body=${body}`;
        });
    });
</script>

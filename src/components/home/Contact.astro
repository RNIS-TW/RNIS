---
import config from "@content/home.json";
import { Mail, MessageCircle, Send, AtSign } from "@lucide/astro";

const { Contact } = config;

const channelIcons: Record<string , typeof Mail> = {
    mail: Mail,
    discord: MessageCircle,
    telegram: Send,
    threads: AtSign,
};
---

<section
    id="contact"
    class="w-full h-fit bg-ink-black py-32"
>
    <div class="container mx-auto px-16 flex flex-col gap-16">
        <div class="w-full max-w-2xl">
            <h1 class="text-6xl font-line-seed font-medium tracking-tight text-icy-blue mt-2">{Contact.title}</h1>
            <p class="text-xl font-sans font-light text-powder-blue mt-4 leading-relaxed">{Contact.description}</p>
        </div>

        <div class="w-full flex gap-16 items-start">
            <div class="w-1/2 grid grid-cols-2 gap-4">
                {
                    Contact.channels.map((channel) => {
                        const Icon = channelIcons[channel.id];
                        return (
                            <a
                                href={channel.available ? channel.href : undefined}
                                target={channel.available ? "_blank" : undefined}
                                rel={channel.available ? "noopener noreferrer" : undefined}
                                aria-disabled={!channel.available}
                                class:list={[ "channel-card flex gap-4 items-start p-5 border border-icy-blue/30", channel.available ? "cursor-pointer hover:border-icy-blue" : "cursor-default opacity-60", ]}
                            >
                                <div class="w-12 h-12 shrink-0 bg-icy-blue shadow-[4px_4px_0_0_#8A6A2C] flex items-center justify-center text-ink-black">
                                    <Icon size={22} stroke-width={2} />
                                </div>
                                <div class="flex flex-col gap-2 flex-1">
                                    <h3 class="text-xl font-medium text-icy-blue">{channel.title}</h3>
                                    <p class="text-sm font-sans font-light text-powder-blue leading-relaxed">
                                        {channel.description}
                                    </p>
                                    <span class="text-sm font-sans font-medium text-cool-sky">{channel.actionLabel}</span>
                                </div>
                            </a>
                        );
                    })
                }
            </div>

            <form
                id="contact-form"
                class="w-1/2 flex flex-col gap-6 p-8 border border-icy-blue/30"
            >
                <div class="grid grid-cols-2 gap-4">
                    <div class="flex flex-col gap-2">
                        <label
                            for="contact-name"
                            class="text-xs font-sans font-medium uppercase tracking-[0.15em] text-icy-blue"
                        >姓名</label>
                        <input
                            id="contact-name"
                            name="name"
                            type="text"
                            required
                            class="input-field"
                        />
                    </div>
                    <div class="flex flex-col gap-2">
                        <label
                            for="contact-email"
                            class="text-xs font-sans font-medium uppercase tracking-[0.15em] text-icy-blue"
                        >電子郵件</label>
                        <input
                            id="contact-email"
                            name="email"
                            type="email"
                            required
                            class="input-field"
                        />
                    </div>
                </div>

                <div class="flex flex-col gap-2">
                    <label
                        for="contact-message"
                        class="text-xs font-sans font-medium uppercase tracking-[0.15em] text-icy-blue"
                    >訊息內容</label>
                    <textarea
                        id="contact-message"
                        name="message"
                        rows="6"
                        required
                        class="input-field resize-none"
                    ></textarea>
                </div>

                <button
                    type="submit"
                    class="w-fit inline-flex items-center gap-2 px-5 py-3 bg-icy-blue text-ink-black font-medium shadow-[4px_4px_0_0_#8A6A2C] hover:translate-x-0.5 hover:translate-y-0.5 hover:shadow-[2px_2px_0_0_#8A6A2C] transition-all"
                >
                    送出
                    <span aria-hidden="true">→</span>
                </button>
            </form>
        </div>
    </div>
</section>

<style>
    .channel-card {
        transition:
            border-color 220ms ease,
            transform 220ms ease;
    }

    .channel-card:hover {
        transform: translateY(-2px);
    }

    .input-field {
        width: 100%;
        padding: 0.65rem 0.9rem;
        background: var(--color-jet-black);
        border: 1px solid rgba(255, 221, 138, 0.3);
        color: var(--color-alice-blue);
        font-family: inherit;
        font-size: 1rem;
    }

    .input-field::placeholder {
        color: var(--color-powder-blue);
    }

    .input-field:focus {
        outline: none;
        border-color: var(--color-icy-blue);
    }
</style>

<script define:vars={{ contactEmail: Contact.email }}>
    const form = document.getElementById("contact-form");

    form?.addEventListener("submit", (event) => {
        event.preventDefault();

        const data = new FormData(form);
        const name = String(data.get("name") ?? "").trim();
        const email = String(data.get("email") ?? "").trim();
        const message = String(data.get("message") ?? "").trim();

        const subject = encodeURIComponent(`來自 ${name} 的聯絡訊息`);
        const body = encodeURIComponent(`${message}\n\n回覆信箱：${email}`);

        window.location.href = `mailto:${contactEmail}?subject=${subject}&body=${body}`;
    });
</script>

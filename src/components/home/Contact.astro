---
import config from "@content/home.json";
import { Mail, MessageCircle, Send, AtSign } from "@lucide/astro";

const { Contact } = config;

const channelIcons: Record<string , typeof Mail> = {
    mail: Mail,
    discord: MessageCircle,
    telegram: Send,
    threads: AtSign,
};
---

<section
    id="contact"
    class="w-full h-fit bg-surface-base py-16 lg:py-32"
>
    <div class="container mx-auto px-6 sm:px-10 lg:px-16 flex flex-col gap-10 lg:gap-16">
        <div class="w-full max-w-2xl">
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-line-seed font-medium tracking-tight text-amber-100 mt-2">{Contact.title}</h1>
            <p class="text-base sm:text-lg font-sans font-light text-secondary mt-4 leading-relaxed">{Contact.description}</p>
        </div>

        <div class="w-full h-fit lg:h-[40vh] flex flex-col lg:flex-row gap-10 lg:gap-16 items-start">
            <div class="w-full lg:w-1/2 h-fit lg:h-full grid grid-cols-1 sm:grid-cols-2 gap-4">
                {
                    Contact.channels.map((channel) => {
                        const Icon = channelIcons[channel.id];
                        return (
                            <a
                                href={channel.available ? channel.href : undefined}
                                target={channel.available ? "_blank" : undefined}
                                rel={channel.available ? "noopener noreferrer" : undefined}
                                aria-disabled={!channel.available}
                                class:list={[ "channel-card flex gap-4 items-start p-5 border border-amber-100/30", channel.available ? "cursor-pointer hover:border-amber-100" : "cursor-default opacity-60", ]}
                            >
                                <div class="w-12 h-12 shrink-0 bg-amber-100 shadow-[4px_4px_0_0_var(--color-amber-300)] flex items-center justify-center text-surface-base">
                                    <Icon size={22} stroke-width={2} />
                                </div>
                                <div class="flex flex-col gap-2 flex-1">
                                    <h3 class="text-lg font-medium text-amber-100">{channel.title}</h3>
                                    <p class="text-sm font-sans font-light text-secondary leading-relaxed">
                                        {channel.description}
                                    </p>
                                    <span class="text-sm font-sans font-medium text-amber-200">{channel.actionLabel}</span>
                                </div>
                            </a>
                        );
                    })
                }
            </div>

            <form
                id="contact-form"
                class="w-full lg:w-1/2 h-fit lg:h-full flex flex-col gap-6 p-5 sm:p-8 border border-amber-100/30"
            >
                <div class="flex flex-col gap-2">
                    <label
                        for="contact-message"
                        class="text-xs font-sans font-medium uppercase tracking-[0.15em] text-amber-100"
                    >{Contact.form.messageLabel}</label>
                    <textarea
                        id="contact-message"
                        name="message"
                        rows="6"
                        required
                        class="input-field resize-none"
                    ></textarea>
                </div>

                <div class="flex flex-col sm:flex-row items-stretch sm:items-end gap-4">
                    <div class="flex flex-col gap-2 flex-1">
                        <label
                            for="contact-name"
                            class="text-xs font-sans font-medium uppercase tracking-[0.15em] text-amber-100"
                        >{Contact.form.nameLabel}</label>
                        <input
                            id="contact-name"
                            name="name"
                            type="text"
                            required
                            class="input-field"
                        />
                    </div>
                    <div class="flex flex-col gap-2 flex-1">
                        <label
                            for="contact-email"
                            class="text-xs font-sans font-medium uppercase tracking-[0.15em] text-amber-100"
                        >{Contact.form.emailLabel}</label>
                        <input
                            id="contact-email"
                            name="email"
                            type="email"
                            required
                            class="input-field"
                        />
                    </div>
                    <button
                        type="submit"
                        class="w-fit inline-flex items-center gap-2 px-5 py-3 bg-amber-100 text-surface-base font-medium shadow-[4px_4px_0_0_var(--color-amber-300)] hover:translate-x-0.5 hover:translate-y-0.5 hover:shadow-[2px_2px_0_0_var(--color-amber-300)] transition-all"
                    >
                        {Contact.form.submitLabel}
                        <span aria-hidden="true">→</span>
                    </button>
                </div>

            </form>
        </div>
    </div>
</section>

<style>
    .channel-card {
        transition:
            border-color 220ms ease,
            transform 220ms ease;
    }

    .channel-card:hover {
        transform: translateY(-2px);
    }

    .input-field {
        width: 100%;
        padding: 0.65rem 0.9rem;
        background: var(--color-surface-raised);
        border: 1px solid rgba(255, 221, 138, 0.3);
        color: var(--text-primary);
        font-family: inherit;
        font-size: 1rem;
    }

    .input-field::placeholder {
        color: var(--text-secondary);
    }

    .input-field:focus {
        outline: none;
        border-color: var(--color-amber-100);
    }
</style>

<script define:vars={{ contactEmail: Contact.email }}>
    const form = document.getElementById("contact-form");

    form?.addEventListener("submit", (event) => {
        event.preventDefault();

        const data = new FormData(form);
        const name = String(data.get("name") ?? "").trim();
        const email = String(data.get("email") ?? "").trim();
        const message = String(data.get("message") ?? "").trim();

        const subject = encodeURIComponent(`來自 ${name} 的聯絡訊息`);
        const body = encodeURIComponent(`${message}\n\n回覆信箱：${email}`);

        window.location.href = `mailto:${contactEmail}?subject=${subject}&body=${body}`;
    });
</script>

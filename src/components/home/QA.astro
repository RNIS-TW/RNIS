---
import config from "@content/home.json";

const { QA } = config;
---

<section class="w-full h-fit min-h-screen bg-air-force-blue">
    <div class="container mx-auto px-16 py-32">
        <div class="w-full h-fit mb-16">
            <h1 class="text-6xl text-alice-blue mb-4">{QA.title}</h1>
            <p class="text-xl text-alice-blue">{QA.description}</p>
        </div>

        <div class="w-full h-fit px-32 flex flex-col" data-faq-list>
            {
                QA.questions.map((faq, index) => (
                    <div
                        class="faq-item border-b border-icy-blue"
                        data-faq-item
                    >
                        <button
                            type="button"
                            class="faq-trigger w-full h-fit flex gap-12 items-center justify-start py-4 px-8 text-left cursor-pointer"
                            aria-expanded="false"
                            aria-controls={`faq-panel-${index}`}
                            id={`faq-trigger-${index}`}
                        >
                            <span class="text-4xl text-light-coral font-bold shrink-0">
                                Q
                            </span>
                            <span class="text-3xl text-alice-blue flex-1">
                                {faq.question}
                            </span>
                            <span
                                class="faq-icon text-5xl text-alice-blue ml-auto shrink-0 leading-none"
                                aria-hidden="true"
                            >
                                +
                            </span>
                        </button>

                        <div
                            id={`faq-panel-${index}`}
                            class="faq-panel"
                            role="region"
                            aria-labelledby={`faq-trigger-${index}`}
                        >
                            <div class="faq-panel-inner">
                                <div class="flex gap-12 items-start px-8 pb-6 pt-1">
                                    <span class="text-4xl text-tea-green font-bold shrink-0">
                                        A
                                    </span>
                                    <p class="text-xl text-alice-blue/90 leading-relaxed pt-1">
                                        {faq.answer}
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                ))
            }
            <div class="w-full h-fit flex gap-12 items-center justify-center py-4 px-8 text-left">
                <p class="text-3xl text-alice-blue">
                    {QA.otherQuestion}
                </p>
                <a
                    href="#contact"
                    class="w-fit h-fit px-4 py-2 bg-yale-blue border border-icy-blue button duration-100 relative"
                >
                    <p class="text-sm text-alice-blue">{QA.contactLabel}</p>
                </a>
            </div>
        </div>
    </div>
</section>

<style>
    .faq-panel {
        display: grid;
        grid-template-rows: 0fr;
        transition: grid-template-rows 320ms cubic-bezier(0.4, 0, 0.2, 1);
    }

    .faq-panel-inner {
        overflow: hidden;
        min-height: 0;
        opacity: 0;
        transform: translateY(-0.35rem);
        transition:
            opacity 240ms ease,
            transform 320ms cubic-bezier(0.4, 0, 0.2, 1);
    }

    .faq-item.is-open .faq-panel {
        grid-template-rows: 1fr;
    }

    .faq-item.is-open .faq-panel-inner {
        opacity: 1;
        transform: translateY(0);
    }

    .faq-icon {
        display: inline-block;
        transition: transform 280ms cubic-bezier(0.4, 0, 0.2, 1);
    }

    .faq-item.is-open .faq-icon {
        transform: rotate(45deg); /* + becomes × */
    }

    .faq-trigger:hover .faq-icon {
        color: var(--color-icy-blue);
    }

    .button:hover {
        transform: scale(1.05) translateY(-1px);
        z-index: 10;
    }
</style>

<script>
    const list = document.querySelector("[data-faq-list]");
    if (list) {
        const items = [
            ...list.querySelectorAll<HTMLElement>("[data-faq-item]"),
        ];

        const closeItem = (item: HTMLElement) => {
            item.classList.remove("is-open");
            const trigger =
                item.querySelector<HTMLButtonElement>(".faq-trigger");
            trigger?.setAttribute("aria-expanded", "false");
        };

        const openItem = (item: HTMLElement) => {
            item.classList.add("is-open");
            const trigger =
                item.querySelector<HTMLButtonElement>(".faq-trigger");
            trigger?.setAttribute("aria-expanded", "true");
        };

        for (const item of items) {
            const trigger =
                item.querySelector<HTMLButtonElement>(".faq-trigger");
            if (!trigger) continue;

            trigger.addEventListener("click", () => {
                const isOpen = item.classList.contains("is-open");

                // accordion: close others
                for (const other of items) {
                    if (other !== item) closeItem(other);
                }

                if (isOpen) closeItem(item);
                else openItem(item);
            });
        }
    }
</script>

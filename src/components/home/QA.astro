---
import config from "@content/home.json";

const { QA: qa } = config;
---

<section
    id="qa"
    aria-labelledby="qa-title"
    class="relative isolate w-full overflow-hidden bg-yale-blue text-alice-blue"
>
    <div class="relative mx-auto max-w-[100rem] px-5 py-16 sm:px-8 sm:py-20 lg:px-[clamp(3rem,7vw,8rem)] lg:py-[clamp(5rem,9vw,9rem)]">
        <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 -z-10 opacity-60 [background-image:radial-gradient(circle_at_76%_18%,rgba(118,186,255,.18),transparent_26rem),linear-gradient(rgba(186,221,254,.035)_1px,transparent_1px),linear-gradient(90deg,rgba(186,221,254,.035)_1px,transparent_1px)] [background-size:auto,56px_56px,56px_56px]"
        ></div>

        <div class="grid gap-14 lg:grid-cols-[minmax(16rem,.58fr)_minmax(0,1.42fr)] lg:gap-[clamp(4rem,9vw,10rem)]">
            <header class="lg:sticky lg:top-24 lg:self-start">
                <p class="font-mono text-[0.65rem] font-semibold tracking-[0.2em] text-cool-sky sm:text-xs">
                    {qa.eyebrow}
                </p>
                <h2
                    id="qa-title"
                    class="mt-6 whitespace-pre-line font-display text-[clamp(3.5rem,7vw,7rem)] font-medium leading-[0.82] tracking-[-0.055em] text-alice-blue"
                >{qa.title}</h2>
                <p class="mt-7 max-w-md text-sm leading-7 text-icy-blue/75 sm:text-base sm:leading-8">
                    {qa.description}
                </p>

                <div class="mt-10 hidden items-center gap-3 font-mono text-[0.62rem] tracking-[0.15em] text-powder-blue/60 lg:flex">
                    <span class="relative flex h-3 w-3">
                        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-tea-green opacity-50 motion-reduce:hidden"></span>
                        <span class="relative inline-flex h-3 w-3 rounded-full bg-tea-green"></span>
                    </span>
                    RESPONSE CHANNEL ONLINE
                </div>
            </header>

            <div class="relative min-w-0 lg:pt-8">
                <div class="signal-rail" aria-hidden="true">
                    <span class="signal-rail__packet"></span>
                </div>

                <div class="qa-list" data-qa-list>
                    {qa.questions.map((item, index) => (
                        <details class="qa-item group" open={index === 0}>
                            <summary class="qa-summary">
                                <span class="qa-index" aria-hidden="true">
                                    <span class="qa-node"></span>
                                    <span class="qa-code">QRY_{String(index + 1).padStart(2, "0")}</span>
                                </span>

                                <span class="min-w-0 flex-1">
                                    <span class="block font-display text-[clamp(1.55rem,3vw,2.6rem)] font-medium leading-[1.08] tracking-[-0.025em] text-alice-blue transition-colors group-hover:text-white">
                                        {item.question}
                                    </span>
                                    <span class="mt-3 block font-mono text-[0.62rem] tracking-[0.16em] text-cool-sky/75 sm:text-[0.68rem]">
                                        {item.meta} / TAP TO READ
                                    </span>
                                </span>

                                <span class="qa-toggle" aria-hidden="true">
                                    <span></span>
                                    <span></span>
                                </span>
                            </summary>

                            <div class="qa-answer-wrap">
                                <div class="qa-answer">
                                    <div class="qa-answer__label">
                                        <span>RES_{String(index + 1).padStart(2, "0")}</span>
                                        <span>200 / OK</span>
                                    </div>
                                    <p>{item.answer}</p>
                                </div>
                            </div>
                        </details>
                    ))}
                </div>

                <footer class="mt-10 flex flex-col gap-5 border-t border-icy-blue/35 pt-8 sm:flex-row sm:items-center sm:justify-between">
                    <div>
                        <p class="font-display text-2xl font-medium tracking-[-0.02em] text-alice-blue sm:text-3xl">
                            {qa.otherQuestion}
                        </p>
                        <p class="mt-2 font-mono text-[0.62rem] tracking-[0.14em] text-powder-blue/60">
                            OPEN A NEW CONVERSATION
                        </p>
                    </div>
                    <a
                        href="#contact"
                        class="group/contact inline-flex min-h-12 w-fit items-center justify-center gap-5 bg-icy-blue px-5 py-3 font-mono text-xs font-semibold tracking-[0.1em] text-ink-black shadow-[5px_5px_0_0_#151c2a] transition-[transform,box-shadow,background-color] hover:translate-x-0.5 hover:translate-y-0.5 hover:bg-alice-blue hover:shadow-[2px_2px_0_0_#151c2a] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-alice-blue focus-visible:ring-offset-4 focus-visible:ring-offset-yale-blue motion-reduce:transform-none motion-reduce:transition-none"
                    >
                        {qa.contactLabel}
                        <span
                            class="text-lg transition-transform group-hover/contact:translate-x-1 motion-reduce:transition-none"
                            aria-hidden="true"
                        >→</span>
                    </a>
                </footer>
            </div>
        </div>
    </div>
</section>

<script>
    const qaLists = document.querySelectorAll<HTMLElement>("[data-qa-list]");

    qaLists.forEach((list) => {
        const items = Array.from(list.querySelectorAll<HTMLDetailsElement>("details"));

        items.forEach((item) => {
            item.addEventListener("toggle", () => {
                if (!item.open) return;

                items.forEach((otherItem) => {
                    if (otherItem !== item) otherItem.open = false;
                });
            });
        });
    });
</script>

<style>
    .signal-rail {
        position: absolute;
        inset: 2rem auto 8.75rem -1.5rem;
        width: 1px;
        background: linear-gradient(to bottom, transparent, rgba(186, 221, 254, 0.48) 8%, rgba(186, 221, 254, 0.48) 92%, transparent);
    }

    .signal-rail__packet {
        position: absolute;
        left: -3px;
        top: 0;
        width: 7px;
        height: 2.75rem;
        background: var(--color-cool-sky);
        box-shadow: 0 0 18px rgba(118, 186, 255, 0.8);
        animation: signal-trace 5s cubic-bezier(0.45, 0, 0.55, 1) infinite;
    }

    .qa-item {
        border-top: 1px solid rgba(186, 221, 254, 0.34);
    }

    .qa-item:last-child {
        border-bottom: 1px solid rgba(186, 221, 254, 0.34);
    }

    .qa-summary {
        display: flex;
        cursor: pointer;
        list-style: none;
        align-items: flex-start;
        gap: clamp(1rem, 3vw, 2.5rem);
        padding: clamp(1.75rem, 4vw, 3rem) 0;
    }

    .qa-summary::-webkit-details-marker {
        display: none;
    }

    .qa-summary:focus-visible {
        outline: 2px solid var(--color-cool-sky);
        outline-offset: 8px;
    }

    .qa-index {
        display: flex;
        width: 4.75rem;
        flex: 0 0 auto;
        align-items: center;
        gap: 0.65rem;
        padding-top: 0.45rem;
        font-family: var(--font-mono);
        font-size: 0.62rem;
        letter-spacing: 0.12em;
        color: rgba(186, 221, 254, 0.62);
    }

    .qa-node {
        width: 0.55rem;
        height: 0.55rem;
        flex: 0 0 auto;
        border: 1px solid var(--color-cool-sky);
        background: var(--color-yale-blue);
        box-shadow: 0 0 0 4px rgba(118, 186, 255, 0.08);
        transition: background-color 240ms ease, box-shadow 240ms ease;
    }

    .qa-toggle {
        position: relative;
        width: 2.75rem;
        height: 2.75rem;
        flex: 0 0 auto;
        border: 1px solid rgba(186, 221, 254, 0.42);
        transition: background-color 240ms ease, border-color 240ms ease;
    }

    .qa-toggle span {
        position: absolute;
        left: 50%;
        top: 50%;
        width: 1rem;
        height: 1px;
        background: var(--color-alice-blue);
        transform: translate(-50%, -50%);
        transition: transform 260ms ease;
    }

    .qa-toggle span:last-child {
        transform: translate(-50%, -50%) rotate(90deg);
    }

    .qa-item[open] .qa-toggle {
        border-color: var(--color-cool-sky);
        background: var(--color-cool-sky);
    }

    .qa-item[open] .qa-toggle span {
        background: var(--color-ink-black);
    }

    .qa-item[open] .qa-toggle span:last-child {
        transform: translate(-50%, -50%) rotate(0deg);
    }

    .qa-item[open] .qa-node {
        background: var(--color-tea-green);
        box-shadow: 0 0 0 5px rgba(190, 248, 184, 0.11), 0 0 18px rgba(190, 248, 184, 0.24);
    }

    .qa-answer-wrap {
        display: grid;
        grid-template-rows: 0fr;
        opacity: 0;
        transition: grid-template-rows 360ms cubic-bezier(0.22, 1, 0.36, 1), opacity 280ms ease;
    }

    .qa-item[open] .qa-answer-wrap {
        grid-template-rows: 1fr;
        opacity: 1;
    }

    .qa-answer {
        min-height: 0;
        overflow: hidden;
        padding-left: calc(4.75rem + clamp(1rem, 3vw, 2.5rem));
    }

    .qa-answer > p {
        max-width: 42rem;
        padding: 0 0 clamp(2rem, 4vw, 3rem) 1.25rem;
        border-left: 2px solid var(--color-tea-green);
        color: rgba(227, 241, 255, 0.82);
        font-size: clamp(0.92rem, 1.6vw, 1.08rem);
        line-height: 1.9;
    }

    .qa-answer__label {
        display: flex;
        max-width: 42rem;
        justify-content: space-between;
        padding: 0 0 0.8rem 1.25rem;
        font-family: var(--font-mono);
        font-size: 0.6rem;
        letter-spacing: 0.15em;
        color: var(--color-tea-green);
    }

    @keyframes signal-trace {
        0%, 8% { top: 0; opacity: 0; }
        14% { opacity: 1; }
        84% { opacity: 1; }
        92%, 100% { top: calc(100% - 2.75rem); opacity: 0; }
    }

    @media (max-width: 1023px) {
        .signal-rail {
            display: none;
        }
    }

    @media (max-width: 639px) {
        .qa-index {
            width: auto;
        }

        .qa-code {
            display: none;
        }

        .qa-answer {
            padding-left: calc(0.55rem + 1rem + 1rem);
        }

        .qa-toggle {
            width: 2.4rem;
            height: 2.4rem;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .signal-rail__packet {
            animation: none;
        }

        .qa-node,
        .qa-toggle,
        .qa-toggle span,
        .qa-answer-wrap {
            transition: none;
        }
    }
</style>

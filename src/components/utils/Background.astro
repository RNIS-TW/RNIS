---
interface Props {
	theme?: 'dark' | 'light';
}

const { theme = 'dark' } = Astro.props;
---

<div
    class="background"
    data-background-theme={theme}
    aria-hidden="true"
>
	<canvas class="background__canvas"></canvas>
</div>

<script>
	type Theme = 'dark' | 'light';

	const CELL = 30;
	const GAP = 2;
	const palettes = {
		dark: { background: '#151c2a', cell: '#1a2333' },
		light: { background: '#e3f1ff', cell: '#d8e9fb' },
	} as const;

	const mix = (hex: string, target: string, amount: number) => {
		const parse = (value: string) => [
			Number.parseInt(value.slice(1, 3), 16),
			Number.parseInt(value.slice(3, 5), 16),
			Number.parseInt(value.slice(5, 7), 16),
		];
		const source = parse(hex);
		const destination = parse(target);
		const channel = (index: number) =>
			Math.round(source[index] + (destination[index] - source[index]) * amount);

		return `rgb(${channel(0)}, ${channel(1)}, ${channel(2)})`;
	};

	const createPermutation = () => {
		const permutation = new Uint8Array(512);
		let seed = 1357;
		const random = () => {
			seed = (seed * 1664525 + 1013904223) >>> 0;
			return seed / 4294967296;
		};
		const values = Array.from({ length: 256 }, (_, index) => index);

		for (let index = 255; index > 0; index--) {
			const swapIndex = Math.floor(random() * (index + 1));
			[values[index], values[swapIndex]] = [values[swapIndex], values[index]];
		}
		for (let index = 0; index < permutation.length; index++) {
			permutation[index] = values[index & 255];
		}

		return permutation;
	};

	const permutation = createPermutation();
	const noise = (x: number, y: number) => {
		const fade = (value: number) => value ** 3 * (value * (value * 6 - 15) + 10);
		const lerp = (start: number, end: number, amount: number) => start + amount * (end - start);
		const gradient = (hash: number, offsetX: number, offsetY: number) => {
			switch (hash & 3) {
				case 0: return offsetX + offsetY;
				case 1: return -offsetX + offsetY;
				case 2: return offsetX - offsetY;
				default: return -offsetX - offsetY;
			}
		};

		const gridX = Math.floor(x) & 255;
		const gridY = Math.floor(y) & 255;
		const offsetX = x - Math.floor(x);
		const offsetY = y - Math.floor(y);
		const easedX = fade(offsetX);
		const easedY = fade(offsetY);
		const aa = permutation[permutation[gridX] + gridY];
		const ab = permutation[permutation[gridX] + gridY + 1];
		const ba = permutation[permutation[gridX + 1] + gridY];
		const bb = permutation[permutation[gridX + 1] + gridY + 1];

		return lerp(
			lerp(gradient(aa, offsetX, offsetY), gradient(ba, offsetX - 1, offsetY), easedX),
			lerp(
				gradient(ab, offsetX, offsetY - 1),
				gradient(bb, offsetX - 1, offsetY - 1),
				easedX,
			),
			easedY,
		);
	};

	const setupBackground = (root: HTMLElement) => {
		if (root.dataset.backgroundReady === 'true') return;
		root.dataset.backgroundReady = 'true';

		const canvas = root.querySelector<HTMLCanvasElement>('canvas');
		const context = canvas?.getContext('2d');
		if (!canvas || !context) return;

		let animationFrame = 0;
		let width = 0;
		let height = 0;
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

		const getTheme = (): Theme => {
			const documentTheme = document.documentElement.dataset.theme;
			if (documentTheme === 'dark' || documentTheme === 'light') return documentTheme;
			return root.dataset.backgroundTheme === 'light' ? 'light' : 'dark';
		};

		const resize = () => {
			const pixelRatio = Math.min(window.devicePixelRatio || 1, 2);
			width = window.innerWidth;
			height = window.innerHeight;
			canvas.width = Math.round(width * pixelRatio);
			canvas.height = Math.round(height * pixelRatio);
			canvas.style.width = `${width}px`;
			canvas.style.height = `${height}px`;
			context.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
		};

		let lastFrameTime = 0;
		const FRAME_INTERVAL = 1000 / 30;

		const draw = (time = 0) => {
			const theme = getTheme();
			const palette = palettes[theme];
			const fills: Record<'base' | 'light10' | 'light20' | 'pop', string> = {
				base: palette.cell,
				light10: mix(palette.cell, '#ffffff', theme === 'dark' ? 0.07 : 0.3),
				light20: mix(palette.cell, '#ffffff', theme === 'dark' ? 0.15 : 0.55),
				pop: mix(palette.cell, '#ffd972', theme === 'dark' ? 0.55 : 0.7),
			};
			root.style.setProperty('--background-color', palette.background);
			context.clearRect(0, 0, width, height);

			const shift = window.scrollY * 0.6;
			const offset = shift % CELL;
			const worldRowBase = Math.floor(shift / CELL);
			const columns = Math.ceil(width / CELL) + 1;
			const rows = Math.ceil(height / CELL) + 2;

			// Bucket cells by fill color first so fillStyle is only reassigned
			// four times per frame instead of once per cell — reassigning
			// fillStyle is a relatively expensive canvas state change, and at
			// ~2000+ cells per frame that dominated frame time during scroll.
			const buckets: Record<keyof typeof fills, Array<[number, number]>> = {
				base: [],
				light10: [],
				light20: [],
				pop: [],
			};

			for (let row = -1; row < rows; row++) {
				for (let column = 0; column < columns; column++) {
					const worldRow = row + worldRowBase;
					const value = noise(column * 0.07, worldRow * 0.07 + time * 0.00002);
					let key: keyof typeof fills = 'base';
					if (value > 0.78) key = 'pop';
					else if (value > 0.6) key = 'light20';
					else if (value > 0.38) key = 'light10';

					buckets[key].push([
						column * CELL + GAP / 2,
						row * CELL + GAP / 2 - offset,
					]);
				}
			}

			for (const key of Object.keys(buckets) as Array<keyof typeof fills>) {
				context.fillStyle = fills[key];
				for (const [x, y] of buckets[key]) {
					context.fillRect(x, y, CELL - GAP, CELL - GAP);
				}
			}
		};

		const animate = (time: number) => {
			animationFrame = window.requestAnimationFrame(animate);
			if (time - lastFrameTime < FRAME_INTERVAL) return;
			lastFrameTime = time;
			draw(time);
		};
		const restartAnimation = () => {
			window.cancelAnimationFrame(animationFrame);
			if (reduceMotion.matches) draw();
			else animationFrame = window.requestAnimationFrame(animate);
		};
		const redraw = () => {
			resize();
			if (reduceMotion.matches) draw();
		};
		const themeObserver = new MutationObserver(() => draw(performance.now()));

		window.addEventListener('resize', redraw);
		window.addEventListener('scroll', () => reduceMotion.matches && draw(), { passive: true });
		reduceMotion.addEventListener('change', restartAnimation);
		themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
		resize();
		restartAnimation();
	};

	const init = () => {
		document.querySelectorAll<HTMLElement>('[data-background-theme]').forEach(setupBackground);
	};

	init();
	document.addEventListener('astro:page-load', init);
</script>

<style>
	.background {
		position: fixed;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		background: var(--background-color, #151c2a);
		transition: background-color 250ms ease;
	}

	.background__canvas {
		display: block;
		width: 100%;
		height: 100%;
	}
</style>


---
const { class: className, ...rest } = Astro.props;
---

<div class:list={['trapezoid', className]} {...rest}></div>
<div class:list={['trapezoid-shadow', className]} {...rest}></div>

<style>
    .trapezoid {
        transition: color 220ms ease;
        border-bottom: 22vh solid var(--color-surface-base);
        /* border-bottom: 160px solid var(--color-surface-base); */
        border-left: 0px solid transparent;
        border-right: 5vw solid transparent;
        /* border-right: 80px solid transparent; */
        height: 0;
        width: 60vw;
    }

    .trapezoid-shadow {
        background: var(--color-logo-dark);
        clip-path: polygon(0 0, calc(55vw + 4px) 0, 100% 100%, 0 100%);
        height: calc(22vh + 4px);
        width: calc(60vw + 4px);
        z-index: -1;
    }

    :global(html[data-theme="light"]) .trapezoid {
        color: var(--color-amber-300);
    }

</style>

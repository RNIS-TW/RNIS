---
import header from "@content/header.json";
import home from "@content/home.json";
import footer from "@content/footer.json";
import link from "@config/link.json";

const linkGroups = [
    link.Footer.navGroup,
    {
        title: "服務",
        links: home.Services.items.map((item) => ({
            name: item.title,
            href: "/#services",
        })),
    },
    link.Footer.termsGroup,
    {
        title: "其他",
        links: [{ name: "系統狀態", href: `https://${header.otherLinks[0].url}` }],
    },
];
---

<footer class="site-content w-full bg-surface-base border-t border-amber-100/20">
    <div class="container mx-auto px-16 py-12 flex flex-col gap-6">
        <div class="w-full flex flex-wrap justify-between gap-16">
            <div class="w-full max-w-sm flex flex-col gap-3">
                <div>
                    <h2 class="text-3xl font-display font-medium tracking-tight text-amber-100">
                        {footer.left}
                    </h2>
                    <p class="text-xs font-sans tracking-widest text-white/70 mt-2">
                        {footer.englishName}
                    </p>
                </div>
                <p class="text-sm font-sans font-light text-white/80 leading-relaxed">
                    {home.hero.description}
                </p>
            </div>

            <div class="flex flex-wrap gap-16">
                {
                    linkGroups.map((group) => (
                        <div class="flex flex-col gap-4">
                            <h3 class="text-xs font-sans font-medium uppercase tracking-[0.15em] text-amber-100/80">
                                {group.title}
                            </h3>
                            <div class="flex flex-col gap-2.5">
                                {group.links.map((link) => (
                                    <a
                                        href={link.href}
                                        class="text-sm font-sans font-light text-secondary hover:text-amber-100 transition-colors"
                                    >
                                        {link.name}
                                    </a>
                                ))}
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>

        <div class="w-full h-px bg-amber-100/20 mt-4"></div>

        <div class="w-full">
            <p class="text-xs font-sans font-light text-white/70">
                &copy; {new Date().getFullYear()} {footer.left}
            </p>
        </div>
    </div>
</footer>

---
import logo from "../../assets/logo.svg";
import NotchButton from "@utils/NotchButton.astro";
import header from "@content/header.json";
import { ChevronDown, Menu, X } from "@lucide/astro/icons";
---

<header
    class="w-full h-16 sm:h-20 fixed z-50 header-line duration-500"
    id="header-block"
    transition:persist
    transition:name="site-header"
>
	<div class="container h-full flex items-center justify-between mx-auto px-6 sm:px-10 lg:px-16 py-3">
		<a href="/" id="header-logo" class="w-fit h-full flex items-center justify-start gap-1.5 sm:gap-2" aria-label="回到首頁">
			<img
			    src={logo.src}
			    alt="Logo"
			    class="h-9 sm:h-10 lg:h-12 w-auto aspect-square object-contain"
			/>
			<h1 class="header-wordmark w-fit h-auto leading-none text-2xl sm:text-3xl lg:text-4xl font-wordmark tracking-wider">{header.title}</h1>
		</a>

		<nav class="hidden lg:flex w-fit h-full gap-6 items-center justify-end">
			{
				header.nav.map((item, index) => {
					const isLast = index === header.nav.length - 1;

					if (!isLast) {
						return (
							<a class="w-fit" href={item.url} data-home-link={item.url === "/" || undefined}>
								<p class="text-base text-primary underline-offset-8 decoration-amber-50 relative header-pages">
									{item.name}
								</p>
							</a>
						);
					}

					return (
						<div class="nav-dropdown w-fit mr-4 relative">
							<a class="w-fit flex items-center gap-1" href={item.url}>
								<p class="text-base text-primary underline-offset-8 decoration-amber-50 relative header-pages">
									{item.name}
								</p>
								<ChevronDown class="nav-dropdown__chevron w-4 h-4 text-primary" />
							</a>

							<div class="nav-dropdown__menu">
								<div class="nav-dropdown__panel w-fit flex flex-col gap-1 p-2 bg-surface-raised border border-amber-100">
									{header.otherLinks.map((link) => (
										<a
										    class="nav-dropdown__link block px-2.5 py-1.5 text-sm text-primary whitespace-nowrap transition-colors hover:text-amber-100 hover:bg-amber-100/10"
										    href={`https://${link.url}`}
										    target="_blank"
										    rel="noopener noreferrer"
										>
											{link.name}
										</a>
									))}
								</div>
							</div>
						</div>
					);
				})
			}
			<NotchButton
			    as="a"
			    href={header.cta.url}
			    color="var(--color-logo-light)"
			    shadow="var(--color-logo-dark)"
			    notch="8px"
			    class="w-fit text-logo-light font-medium"
			>
				{header.cta.label}
			</NotchButton>
		</nav>

		<button
			type="button"
			id="mobile-menu-toggle"
			class="lg:hidden flex items-center justify-center w-10 h-10 text-primary"
			aria-expanded="false"
			aria-controls="mobile-menu"
			aria-label="Toggle menu"
		>
			<Menu id="mobile-menu-icon-open" class="w-6 h-6" />
			<X id="mobile-menu-icon-close" class="w-6 h-6 hidden" />
		</button>
	</div>

	<div id="mobile-menu" class="mobile-menu lg:hidden">
		<nav class="w-full h-fit flex flex-col gap-1 px-6 py-4 bg-surface-base border-t border-amber-100/20">
			{
				header.nav.map((item) => (
					<a
						class="w-full block py-3 text-base text-primary border-b border-amber-100/10"
						href={item.url}
						data-home-link={item.url === "/" || undefined}
					>
						{item.name}
					</a>
				))
			}
			{
				header.otherLinks.map((link) => (
					<a
						class="w-full block py-3 text-base text-primary border-b border-amber-100/10"
						href={`https://${link.url}`}
						target="_blank"
						rel="noopener noreferrer"
					>
						{link.name}
					</a>
				))
			}
			<NotchButton
			    as="a"
			    href={header.cta.url}
			    color="var(--color-logo-light)"
			    shadow="var(--color-logo-dark)"
			    notch="8px"
			    class="w-fit text-logo-light font-medium mt-4"
			>
				{header.cta.label}
			</NotchButton>
		</nav>
	</div>
</header>

<style>
	.header-wordmark {
		-webkit-text-stroke: 1.5px white;
		paint-order: stroke fill;
		background: linear-gradient(135deg, var(--color-logo-light), var(--color-logo-dark));
		background-clip: text;
		-webkit-background-clip: text;
		color: transparent;
	}

	.header-pages::before {
		content: "";
		position: absolute;
		bottom: -4px;
		left: 0;
		width: 0;
		height: 2px;
		background-color: var(--color-amber-100);
		transition: width 0.15s ease;
		z-index: -1;
	}

	.header-pages:hover::before {
		width: 100%;
	}

	.header-line::before {
		content: "";
		position: absolute;
		bottom: -1px;
		left: 0;
		width: 100%;
		height: 4px;
		background: linear-gradient(to right, var(--color-logo-light), var(--color-logo-dark), var(--color-logo-light));
		/* background: linear-gradient(to right, var(--color-logo-dark), var(--color-logo-light), var(--color-logo-dark)); */
		opacity: 0;
		transition: opacity 300ms ease;
		z-index: -1;
	}

	.header-line.header-border::before {
		opacity: 1;
	}

	.nav-dropdown__chevron {
		transition: transform 200ms ease;
	}

	.nav-dropdown:hover .nav-dropdown__chevron,
	.nav-dropdown:focus-within .nav-dropdown__chevron {
		transform: rotate(180deg);
	}

	.nav-dropdown__menu {
		position: absolute;
		top: 100%;
		left: 0;
		/* padding (not margin) keeps the gap inside the hoverable box, so the
		   pointer never leaves .nav-dropdown while crossing from the trigger
		   down to the panel. */
		padding-top: 0.75rem;
		opacity: 0;
		transform: translateY(-0.25rem);
		pointer-events: none;
		transition:
			opacity 200ms ease,
			transform 200ms ease;
		z-index: 10;
	}

	.nav-dropdown:hover .nav-dropdown__menu,
	.nav-dropdown:focus-within .nav-dropdown__menu {
		opacity: 1;
		transform: translateY(0);
		pointer-events: auto;
	}

	.mobile-menu {
		position: absolute;
		top: 100%;
		left: 0;
		width: 100%;
		max-height: calc(100dvh - 100%);
		overflow-y: auto;
		opacity: 0;
		transform: translateY(-0.5rem);
		pointer-events: none;
		transition:
			opacity 200ms ease,
			transform 200ms ease;
	}

	.mobile-menu.is-open {
		opacity: 1;
		transform: translateY(0);
		pointer-events: auto;
	}
</style>

<script transition:persist is:inline>

	const headerBlock = document.getElementById("header-block");
	const headerLogo = document.getElementById("header-logo");
	const windowHeight = window.innerHeight;
	const offset = window.innerWidth * 0.12; // 20vw
	const triggerPoint = windowHeight - offset;
	const borderTriggerPoint = windowHeight - offset;

	const menuToggle = document.getElementById("mobile-menu-toggle");
	const mobileMenu = document.getElementById("mobile-menu");
	const iconOpen = document.getElementById("mobile-menu-icon-open");
	const iconClose = document.getElementById("mobile-menu-icon-close");

	const closeMobileMenu = () => {
		mobileMenu?.classList.remove("is-open");
		menuToggle?.setAttribute("aria-expanded", "false");
		iconOpen?.classList.remove("hidden");
		iconClose?.classList.add("hidden");
	};

	menuToggle?.addEventListener("click", () => {
		const isOpen = mobileMenu?.classList.toggle("is-open");
		menuToggle.setAttribute("aria-expanded", String(!!isOpen));
		iconOpen?.classList.toggle("hidden", !!isOpen);
		iconClose?.classList.toggle("hidden", !isOpen);
	});

	mobileMenu?.querySelectorAll("a").forEach((link) => {
		link.addEventListener("click", closeMobileMenu);
	});

	const scrollToTopIfHome = (event) => {
		if (window.location.pathname !== "/") return;
		event.preventDefault();

		const lenis = window.__lenis;
		if (lenis) lenis.scrollTo(0);
		else window.scrollTo({ top: 0, behavior: "smooth" });
	};

	headerLogo?.addEventListener("click", scrollToTopIfHome);
	document.querySelectorAll("[data-home-link]").forEach((link) => {
		link.addEventListener("click", scrollToTopIfHome);
	});

	const scrollToHashIfSamePage = (event) => {
		const link = event.currentTarget;
		const url = new URL(link.href, window.location.href);
		if (url.pathname !== window.location.pathname || !url.hash) return;

		const target = document.querySelector(url.hash);
		if (!target) return;
		event.preventDefault();

		const lenis = window.__lenis;
		if (lenis) lenis.scrollTo(target);
		else target.scrollIntoView({ behavior: "smooth" });
	};

	document.querySelectorAll('a[href*="#"]').forEach((link) => {
		link.addEventListener("click", scrollToHashIfSamePage);
	});

	window.addEventListener("resize", () => {
		if (window.innerWidth >= 1024) closeMobileMenu();
	});

	let scrollTicking = false;

	const updateHeaderOnScroll = () => {
		scrollTicking = false;
		if (!headerBlock) return;

		headerBlock.classList.toggle("bg-surface-base/80", window.scrollY > triggerPoint);
		headerBlock.classList.toggle("backdrop-blur-sm", window.scrollY > triggerPoint);
		headerBlock.classList.toggle("header-border", window.scrollY > borderTriggerPoint);
	};

	window.addEventListener("scroll", () => {
		if (scrollTicking) return;
		scrollTicking = true;
		window.requestAnimationFrame(updateHeaderOnScroll);
	}, { passive: true });

</script>
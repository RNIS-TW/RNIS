---
import header from '../../content/header.json';
---

<header class="site-header">
	<a
	    class="site-header__brand"
	    href="/"
	    aria-label={`${header.title} 首頁`}
	>{header.title}</a>

	<button
	    class="theme-toggle"
	    type="button"
	    aria-label="切換至淺色模式"
	    aria-pressed="true"
	    data-theme-toggle
	>
		<span class="theme-toggle__track" aria-hidden="true">
			<svg
			    class="theme-toggle__icon theme-toggle__icon--sun"
			    viewBox="0 0 24 24"
			>
				<circle cx="12" cy="12" r="3.5"></circle>
				<path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"></path>
			</svg>
			<svg
			    class="theme-toggle__icon theme-toggle__icon--moon"
			    viewBox="0 0 24 24"
			>
				<path d="M20.2 15.4A8.7 8.7 0 0 1 8.6 3.8 8.7 8.7 0 1 0 20.2 15.4Z"></path>
			</svg>
			<span class="theme-toggle__thumb"></span>
		</span>
		<span class="sr-only">切換色彩主題</span>
	</button>
</header>

<script>
	type Theme = 'dark' | 'light';
	type ViewTransitionDocument = Document & {
		startViewTransition?: (update: () => void) => { finished: Promise<void> };
	};

	const storageKey = 'rnis-theme';
	const root = document.documentElement;
	const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');

	const currentTheme = (): Theme => root.dataset.theme === 'light' ? 'light' : 'dark';
	const updateToggle = (theme: Theme) => {
		if (!toggle) return;
		const isDark = theme === 'dark';
		toggle.setAttribute('aria-pressed', String(isDark));
		toggle.setAttribute('aria-label', `切換至${isDark ? '淺色' : '深色'}模式`);
		toggle.title = `切換至${isDark ? '淺色' : '深色'}模式`;
	};
	const applyTheme = (theme: Theme) => {
		root.dataset.theme = theme;
		root.style.colorScheme = theme;
		document.querySelector<HTMLMetaElement>('meta[name="theme-color"]')
			?.setAttribute('content', theme === 'dark' ? '#151c2a' : '#e3f1ff');
		try {
			localStorage.setItem(storageKey, theme);
		} catch {}
		updateToggle(theme);
		window.dispatchEvent(new CustomEvent('themechange', { detail: { theme } }));
	};

	updateToggle(currentTheme());
	toggle?.addEventListener('click', () => {
		const nextTheme: Theme = currentTheme() === 'dark' ? 'light' : 'dark';
		const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
		const startViewTransition = (document as ViewTransitionDocument).startViewTransition;

		if (reduceMotion || !startViewTransition) {
			applyTheme(nextTheme);
			return;
		}

		const bounds = toggle.getBoundingClientRect();
		root.style.setProperty('--theme-toggle-x', `${bounds.left + bounds.width / 2}px`);
		root.style.setProperty('--theme-toggle-y', `${bounds.top + bounds.height / 2}px`);
		root.dataset.themeTransition = 'active';

		const transition = startViewTransition.call(document, () => applyTheme(nextTheme));
		transition.finished.finally(() => delete root.dataset.themeTransition);
	});
</script>

<style>
	.site-header {
		position: fixed;
		z-index: 20;
		top: 0;
		left: 0;
		display: flex;
		width: 100%;
		align-items: center;
		justify-content: space-between;
		padding: 1.25rem clamp(1.25rem, 4vw, 4rem);
		pointer-events: none;
	}

	.site-header__brand,
	.theme-toggle {
		pointer-events: auto;
	}

	.site-header__brand {
		color: var(--text-primary);
		font-family: var(--font-display);
		font-size: 1.15rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-decoration: none;
	}

	.theme-toggle {
		display: none;
		appearance: none;
		padding: 0;
		border: 0;
		border-radius: 999px;
		background: transparent;
		color: var(--text-primary);
		cursor: pointer;
	}

	.theme-toggle__track {
		position: relative;
		display: grid;
		width: 4.25rem;
		height: 2.25rem;
		grid-template-columns: 1fr 1fr;
		align-items: center;
		border: 1px solid var(--border-subtle);
		border-radius: inherit;
		background: var(--surface-raised);
		box-shadow: 0 0.35rem 1.1rem var(--shadow-color);
		transition: background-color 220ms ease, border-color 220ms ease, box-shadow 220ms ease;
	}

	.theme-toggle__thumb {
		position: absolute;
		top: 0.25rem;
		left: 0.25rem;
		width: 1.75rem;
		height: 1.75rem;
		border-radius: 50%;
		background: var(--toggle-thumb);
		box-shadow: 0 0.15rem 0.45rem var(--shadow-color);
		transform: translateX(2rem);
		transition: transform 360ms cubic-bezier(0.22, 1, 0.36, 1), background-color 220ms ease;
	}

	:global(html[data-theme='light']) .theme-toggle__thumb {
		transform: translateX(0);
	}

	.theme-toggle__icon {
		z-index: 1;
		width: 1rem;
		height: 1rem;
		justify-self: center;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.8;
		transition: color 220ms ease, transform 360ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.theme-toggle__icon--sun {
		color: #8a6200;
	}

	.theme-toggle__icon--moon {
		color: #d9eaff;
	}

	.theme-toggle:hover .theme-toggle__icon {
		transform: rotate(12deg) scale(1.08);
	}

	.theme-toggle:focus-visible {
		outline: 3px solid var(--focus-ring);
		outline-offset: 3px;
	}

	@media (prefers-reduced-motion: reduce) {
		.theme-toggle__track,
		.theme-toggle__thumb,
		.theme-toggle__icon {
			transition-duration: 0.01ms;
		}
	}
</style>

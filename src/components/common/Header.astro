---
import logo from "../../assets/logo.svg";
import NotchButton from "@utils/NotchButton.astro";
import header from "@content/header.json";
import { ChevronDown } from "@lucide/astro/icons";
---

<header
    class="w-full h-20 fixed z-50 header-line duration-500"
    id="header-block"
>
	<div class="container h-full flex items-center justify-between mx-auto px-16 py-3">
		<div class="w-fit h-full flex items-center justify-start gap-4">
			<img
			    src={logo.src}
			    alt="Logo"
			    class="h-12 w-auto aspect-square object-contain"
			/>
			<h1 class="w-fit h-auto text-4xl">{header.title}</h1>
		</div>

		<nav class="w-fit h-full flex gap-6 items-center justify-end">
			{
				header.nav.map((item, index) => {
					const isLast = index === header.nav.length - 1;

					if (!isLast) {
						return (
							<a class="w-fit" href={item.url}>
								<p class="text-base text-primary underline-offset-8 decoration-amber-50 relative header-pages">
									{item.name}
								</p>
							</a>
						);
					}

					return (
						<div class="nav-dropdown w-fit mr-4 relative">
							<a class="w-fit flex items-center gap-1" href={item.url}>
								<p class="text-base text-primary underline-offset-8 decoration-amber-50 relative header-pages">
									{item.name}
								</p>
								<ChevronDown class="nav-dropdown__chevron w-4 h-4 text-primary" />
							</a>

							<div class="nav-dropdown__menu">
								<div class="nav-dropdown__panel w-fit flex flex-col gap-1 p-2 bg-surface-raised border border-amber-100">
									{header.otherLinks.map((link) => (
										<a
										    class="nav-dropdown__link block px-2.5 py-1.5 text-sm text-primary whitespace-nowrap transition-colors hover:text-amber-100 hover:bg-amber-100/10"
										    href={`https://${link.url}`}
										    target="_blank"
										    rel="noopener noreferrer"
										>
											{link.name}
										</a>
									))}
								</div>
							</div>
						</div>
					);
				})
			}
			<NotchButton
			    as="a"
			    href={header.cta.url}
			    color="var(--color-amber-100)"
			    notch="8px"
			    class="w-fit text-amber-100 font-medium"
			>
				{header.cta.label}
			</NotchButton>
		</nav>
	</div>
</header>

<script></script>

<style>
	.header-pages::before {
		content: "";
		position: absolute;
		bottom: -4px;
		left: 0;
		width: 0;
		height: 2px;
		background-color: var(--color-amber-100);
		transition: width 0.15s ease;
		z-index: -1;
	}

	.header-pages:hover::before {
		width: 100%;
	}

	.header-line::before {
		content: "";
		position: absolute;
		bottom: -1px;
		left: 50%;
		width: 0;
		height: 1px;
		background-color: var(--color-amber-100);
		transition: width 0.5s ease, left 0.5s ease;
		z-index: -1;
	}

	.header-line.header-border::before {
		left: 0;
		width: 100%;
	}

	.nav-dropdown__chevron {
		transition: transform 200ms ease;
	}

	.nav-dropdown:hover .nav-dropdown__chevron,
	.nav-dropdown:focus-within .nav-dropdown__chevron {
		transform: rotate(180deg);
	}

	.nav-dropdown__menu {
		position: absolute;
		top: 100%;
		left: 0;
		/* padding (not margin) keeps the gap inside the hoverable box, so the
		   pointer never leaves .nav-dropdown while crossing from the trigger
		   down to the panel. */
		padding-top: 0.75rem;
		opacity: 0;
		transform: translateY(-0.25rem);
		pointer-events: none;
		transition:
			opacity 200ms ease,
			transform 200ms ease;
		z-index: 10;
	}

	.nav-dropdown:hover .nav-dropdown__menu,
	.nav-dropdown:focus-within .nav-dropdown__menu {
		opacity: 1;
		transform: translateY(0);
		pointer-events: auto;
	}
</style>

<script>

	const headerBlock = document.getElementById("header-block");
	const windowHeight = window.innerHeight;
	const triggerPoint = windowHeight * 0.3;
	const borderTriggerPoint = windowHeight;
	
	window.addEventListener("scroll", () => {

		if(!headerBlock) return;
		if (window.scrollY > triggerPoint) {
			headerBlock.classList.add("bg-surface-base/80", "backdrop-blur-sm");
		} else {
			headerBlock.classList.remove("bg-surface-base/80", "backdrop-blur-sm");
		}

		if (window.scrollY > borderTriggerPoint) {
			headerBlock.classList.add("header-border");
		} else {
			headerBlock.classList.remove("header-border");
		}
	});

</script>
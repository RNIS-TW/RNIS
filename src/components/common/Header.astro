---
import logo from "../../assets/logo.svg";
import NotchButton from "@utils/NotchButton.astro";
import header from "@content/header.json";
---

<header
    class="w-full h-20 fixed z-50 header-line duration-500"
    id="header-block"
>
	<div class="container h-full flex items-center justify-between mx-auto px-16 py-3">
		<div class="w-fit h-full flex items-center justify-start gap-4">
			<img
			    src={logo.src}
			    alt="Logo"
			    class="h-12 w-auto aspect-square object-contain"
			/>
			<h1 class="w-fit h-auto text-4xl">{header.title}</h1>
		</div>

		<nav class="w-fit h-full flex gap-6 items-center justify-end">
			{
				header.nav.map((item, index) => (
					<a
						class:list={["w-fit", index === header.nav.length - 1 && "mr-4"]}
						href={item.url}
					>
						<p class="text-base text-primary underline-offset-8 decoration-amber-50 relative header-pages">
							{item.name}
						</p>
					</a>
				))
			}
			<NotchButton
			    as="a"
			    href={header.cta.url}
			    color="var(--color-amber-100)"
			    notch="8px"
			    class="w-fit text-amber-100 font-medium"
			>
				{header.cta.label}
			</NotchButton>
		</nav>
	</div>
</header>

<script></script>

<style>
	.header-pages::before {
		content: "";
		position: absolute;
		bottom: -4px;
		left: 0;
		width: 0;
		height: 2px;
		background-color: var(--color-amber-100);
		transition: width 0.15s ease;
		z-index: -1;
	}

	.header-pages:hover::before {
		width: 100%;
	}

	.header-line::before {
		content: "";
		position: absolute;
		bottom: -1px;
		left: 50%;
		width: 0;
		height: 1px;
		background-color: var(--color-amber-100);
		transition: width 0.5s ease, left 0.5s ease;
		z-index: -1;
	}

	.header-line.header-border::before {
		left: 0;
		width: 100%;
	}
</style>

<script>

	const headerBlock = document.getElementById("header-block");
	const windowHeight = window.innerHeight;
	const triggerPoint = windowHeight * 0.3;
	const borderTriggerPoint = windowHeight;
	
	window.addEventListener("scroll", () => {

		if(!headerBlock) return;
		if (window.scrollY > triggerPoint) {
			headerBlock.classList.add("bg-surface-base/80", "backdrop-blur-sm");
		} else {
			headerBlock.classList.remove("bg-surface-base/80", "backdrop-blur-sm");
		}

		if (window.scrollY > borderTriggerPoint) {
			headerBlock.classList.add("header-border");
		} else {
			headerBlock.classList.remove("header-border");
		}
	});

</script>